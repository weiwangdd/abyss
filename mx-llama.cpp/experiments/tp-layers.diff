+// abyss: with a Meta device among the backends (ABYSS_TP_LAYERS), an input it computed whole on every lane is copied
+// for a split on a GPU that one of its lanes runs on from that lane, on the GPU: the lane's stream waits for the work the
+// split's backend has queued (it may still read the memory of the copy, as with overlap_gpus), the CUDA copy then follows
+// the lane's work on its stream and the split's stream waits for it. The host used to wait for the whole Meta device and
+// copy the tensor through host memory, so it could queue nothing after the seam until the Meta device was done.
+// ABYSS_TP_SEAM=0 keeps that path
+static bool abyss_meta_seam_copy(ggml_backend_sched_t sched, ggml_backend_t input_backend, int split_backend_id,
+        const struct ggml_tensor * input, struct ggml_tensor * input_cpy) {
+    static const bool enabled = [] {
+        const char * e = getenv("ABYSS_TP_SEAM");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    ggml_backend_t split_backend = sched->backends[split_backend_id];
+    if (!enabled || input_backend == nullptr || !ggml_backend_is_meta(input_backend) || ggml_backend_is_meta(split_backend) ||
+            split_backend->iface.cpy_tensor_async == NULL ||
+            ggml_backend_dev_type(ggml_backend_get_device(split_backend)) != GGML_BACKEND_DEVICE_TYPE_GPU ||
+            input_cpy->buffer == NULL || !ggml_is_contiguous(input_cpy)) {
+        return false;
+    }
+    ggml_backend_dev_t dev = ggml_backend_get_device(split_backend);
+    for (size_t j = 0; j < ggml_backend_meta_n_backends(input_backend); j++) {
+        ggml_backend_t lane = ggml_backend_meta_simple_backend(input_backend, j);
+        if (ggml_backend_get_device(lane) != dev) {
+            continue;
+        }
+        ggml_tensor * src = ggml_backend_meta_mirrored_tensor(input, j);
+        if (src == NULL || ggml_nbytes(src) != ggml_nbytes(input_cpy)) {
+            return false;
+        }
+        if (sched->overlap_events[split_backend_id] == NULL) {
+            sched->overlap_events[split_backend_id] = ggml_backend_event_new(dev);
+        }
+        ggml_backend_event_t ev = sched->overlap_events[split_backend_id];
+        if (ev == NULL) {
+            return false;
+        }
+        ggml_backend_event_record(ev, split_backend);
+        ggml_backend_event_wait(lane, ev);
+        return split_backend->iface.cpy_tensor_async(lane, split_backend, src, input_cpy);
+    }
+    return false;
+}
