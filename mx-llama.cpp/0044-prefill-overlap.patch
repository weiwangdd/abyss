From bfa58adc735d7e2471cde9516751624fe4b5abdb Mon Sep 17 00:00:00 2001
From: abyss <abyss@localhost>
Date: Sun, 8 Nov 2026 23:40:19 +0100
Subject: [PATCH] abyss: ABYSS_OVERLAP=1 lets the two GPUs work on consecutive
 ubatches of a prompt at once, GPU0 on the next ubatch's layers 0-11 while
 GPU1 computes this one's 13-39, with one copy of the inputs, no more device
 memory and the same results: the host no longer waits for a GPU before it
 copies the inputs of a split there - a large graph input for a busy GPU is
 staged and uploaded on the split's stream behind its queued work (an idle GPU
 or a small input is copied as before), host inputs from CPU splits likewise
 up to ABYSS_OVERLAP_HOST_MAX (1 GiB), each staged input alternates two pinned
 buffers per backend with an event each, outgrown staging buffers are freed at
 the next synchronize (cudaFreeHost synchronizes the device), a new graph
 layout drains the backends only when a buffer would grow (the mask inputs
 grow every ubatch), and empty inputs (the output rows of a ubatch without
 outputs, for the halves of the output head) are neither copied nor waited
 for, which made GPU0 wait for all of GPU1's queued work at the end of each
 ubatch; the MoE selections for cb_moe_ids alternate two pinned buffers with
 an event per backend instead of a synchronize per ubatch; with
 CUDA_SCALE_LAUNCH_QUEUES=4x a 96k-token prefill takes 28.7 s instead of 40.9
 and 193k 58.1 instead of 83.5, an agent session's later turns and the decode
 the same; ABYSS_SYNC_TRACE=<ms> prints the host waits of the scheduler with
 their source line and input

---
 ggml/src/ggml-backend.cpp | 242 ++++++++++++++++++++++++++++++++++----
 src/llama-context.cpp     | 104 +++++++++++++---
 src/llama-context.h       |  10 ++
 3 files changed, 315 insertions(+), 41 deletions(-)

diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index 43be9c4..982c73e 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -944,6 +944,8 @@ struct ggml_backend_sched_input_staging {
     int copy_id;
     size_t size;
     ggml_backend_buffer_t buffer;
+    ggml_backend_event_t event; // abyss: with ABYSS_OVERLAP, after the last upload from the buffer
+    bool recorded;
 };
 
 struct ggml_backend_sched_timing {
@@ -1042,6 +1044,9 @@ struct ggml_backend_sched {
 
     bool async_host_inputs; // abyss: see ggml_backend_sched_set_async_host_inputs
     bool overlap_gpus;      // abyss: see ggml_backend_sched_set_overlap_gpus
+    std::unordered_map<uint64_t, int> * abyss_stage_toggle; // abyss: ABYSS_OVERLAP, the next buffer of each staged input
+    std::vector<ggml_backend_buffer_t> * abyss_stage_retired; // abyss: ABYSS_OVERLAP, outgrown staging buffers
+    ggml_backend_event_t abyss_probe_events[GGML_SCHED_MAX_BACKENDS]; // abyss: ABYSS_OVERLAP, see abyss_backend_busy
     ggml_backend_event_t overlap_events[GGML_SCHED_MAX_BACKENDS]; // abyss: for overlap_gpus, made when first needed
 
     char * context_buffer;
@@ -1070,6 +1075,69 @@ static int ggml_backend_sched_env_int(const char * name, int fallback) {
     return value != nullptr ? atoi(value) : fallback;
 }
 
+// abyss: ABYSS_OVERLAP=1 lets the host go on while a GPU still works on the previous ubatch: a graph input of a GPU split
+// is staged and uploaded on the split's stream behind the work queued there, and with one copy of the inputs that work
+// is all that reads it, so the host does not wait for the GPU first; a host input of a GPU split from a CPU split goes
+// the same way up to ABYSS_OVERLAP_HOST_MAX bytes (default 1 GiB; 1 MiB without the switch, as before)
+static bool abyss_overlap() {
+    static const bool v = []() {
+        const char * e = getenv("ABYSS_OVERLAP");
+        return e != nullptr && atoi(e) != 0;
+    }();
+    return v;
+}
+
+static size_t abyss_async_host_input_max() {
+    static const size_t v = []() {
+        if (!abyss_overlap()) {
+            return (size_t) 1024*1024;
+        }
+        const char * e = getenv("ABYSS_OVERLAP_HOST_MAX");
+        return e != nullptr ? (size_t) atoll(e) : (size_t) 1024*1024*1024;
+    }();
+    return v;
+}
+
+// abyss: ABYSS_SYNC_TRACE=<ms> prints each host wait of the scheduler of at least that long, with its source line
+static int64_t abyss_sync_trace_min_us() {
+    static const int64_t v = []() {
+        const char * e = getenv("ABYSS_SYNC_TRACE");
+        return e != nullptr ? (int64_t) (atof(e) * 1000) : (int64_t) -1;
+    }();
+    return v;
+}
+
+static const char * abyss_sync_what = "";
+
+static void abyss_sync_backend(ggml_backend_t backend, int line) {
+    const int64_t min_us = abyss_sync_trace_min_us();
+    if (min_us < 0) {
+        ggml_backend_synchronize(backend);
+        return;
+    }
+    const int64_t t0 = ggml_time_us();
+    ggml_backend_synchronize(backend);
+    const int64_t dt = ggml_time_us() - t0;
+    if (dt >= min_us) {
+        fprintf(stderr, "abyss sync: line %d %s %.2f ms at %.6f for %s\n", line, ggml_backend_name(backend), dt / 1e3, t0 / 1e6,
+                abyss_sync_what);
+    }
+}
+
+static void abyss_sync_event(ggml_backend_event_t event, int line) {
+    const int64_t min_us = abyss_sync_trace_min_us();
+    if (min_us < 0) {
+        ggml_backend_event_synchronize(event);
+        return;
+    }
+    const int64_t t0 = ggml_time_us();
+    ggml_backend_event_synchronize(event);
+    const int64_t dt = ggml_time_us() - t0;
+    if (dt >= min_us) {
+        fprintf(stderr, "abyss sync: line %d event %.2f ms at %.6f for %s\n", line, dt / 1e3, t0 / 1e6, abyss_sync_what);
+    }
+}
+
 static int ggml_backend_sched_default_n_copies(ggml_backend_t * backends, int n_backends, bool parallel) {
     if (!parallel) {
         return 1;
@@ -1177,8 +1245,18 @@ static void ggml_backend_sched_timing_trace_input(
 }
 
 static void ggml_backend_sched_free_input_staging(ggml_backend_sched_t sched) {
+    if (sched->abyss_stage_retired != nullptr) {
+        for (ggml_backend_buffer_t buf : *sched->abyss_stage_retired) {
+            ggml_backend_buffer_free(buf);
+        }
+        delete sched->abyss_stage_retired;
+        sched->abyss_stage_retired = nullptr;
+    }
+    delete sched->abyss_stage_toggle;
+    sched->abyss_stage_toggle = nullptr;
     for (int i = 0; i < sched->n_input_staging; i++) {
         ggml_backend_buffer_free(sched->input_staging[i].buffer);
+        ggml_backend_event_free(sched->input_staging[i].event);
     }
     free(sched->input_staging);
     sched->input_staging = nullptr;
@@ -1186,6 +1264,38 @@ static void ggml_backend_sched_free_input_staging(ggml_backend_sched_t sched) {
     sched->input_staging_capacity = 0;
 }
 
+// abyss: with ABYSS_OVERLAP, whether a GPU still has work queued. A large input of a split on an idle GPU is copied
+// directly, as without the switch: waiting for that GPU costs nothing then, and staging would cost the host a memcpy of
+// the input on the critical path of a call of a ubatch or two
+static bool abyss_backend_busy(ggml_backend_sched_t sched, int backend_id) {
+    ggml_backend_t backend = sched->backends[backend_id];
+    if (ggml_backend_dev_type(ggml_backend_get_device(backend)) != GGML_BACKEND_DEVICE_TYPE_GPU ||
+            backend->device == nullptr || backend->device->iface.event_query == nullptr) {
+        return true;
+    }
+    if (sched->abyss_probe_events[backend_id] == nullptr) {
+        sched->abyss_probe_events[backend_id] = ggml_backend_event_new(ggml_backend_get_device(backend));
+        if (sched->abyss_probe_events[backend_id] == nullptr) {
+            return true;
+        }
+    }
+    ggml_backend_event_record(sched->abyss_probe_events[backend_id], backend);
+    return !ggml_backend_event_query(sched->abyss_probe_events[backend_id]);
+}
+
+// abyss: with ABYSS_OVERLAP, mark the upload just queued from a staging buffer, so the buffer's next use waits for it
+static void abyss_staging_record(ggml_backend_sched_input_staging * staging, ggml_backend_t backend) {
+    if (!abyss_overlap()) {
+        return;
+    }
+    if (staging->event == nullptr) {
+        staging->event = ggml_backend_event_new(ggml_backend_get_device(backend));
+        GGML_ASSERT(staging->event != nullptr);
+    }
+    ggml_backend_event_record(staging->event, backend);
+    staging->recorded = true;
+}
