+// FP4 (e2m1) quantize-dequantize in blocks of 32 along dim 0, with the power-of-two scale 2^ceil(log2(amax/6)) of the
+// reference's fp4_act_quant. Built from plain ops: the e2m1 grid steps 0.5 up to 2, 1 up to 4 and 2 up to 6, and
+// ggml_round breaks ties away from zero where the hardware rounds to even, which only matters on exact ties.
+ggml_tensor * llama_model_deepseek4::graph::build_fp4_qdq(ggml_tensor * x) const {
+    const int64_t n = ggml_nelements(x);
+    GGML_ASSERT(x->ne[0] % 32 == 0);
+
+    ggml_tensor * b = ggml_reshape_2d(ctx0, ggml_is_contiguous(x) ? x : ggml_cont(ctx0, x), 32, n/32);
+
+    ggml_tensor * amax = ggml_pool_1d(ctx0, ggml_abs(ctx0, b), GGML_OP_POOL_MAX, 32, 32, 0);
+    amax = ggml_clamp(ctx0, amax, 6.0f*1.17549435e-38f, INFINITY);
