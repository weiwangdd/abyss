+    // the small offset keeps an exact power of two from stepping up after the log
+    ggml_tensor * e = ggml_scale_bias(ctx0, ggml_log(ctx0, ggml_scale(ctx0, amax, 1.0f/6.0f)), 1.0f/logf(2.0f), -1e-6f);
