From 76e35babb5c5bb301abdb38b5b32cc2a972d6dc1 Mon Sep 17 00:00:00 2001
From: abyss <abyss@localhost>
Date: Sun, 8 Nov 2026 16:29:07 +0100
Subject: [PATCH] abyss: CUDA graphs outlive an idle period, as upstream
 00f113ece (#30662): the cache swept every 5 s and dropped the graphs unused
 for 10 s, and a conversation pauses between turns (the user, its tools) and a
 long prefill uses no decode graph, so the first decode step after such a
 pause swept every decode graph away, the one being looked up among them, and
 each was captured again; now after 10 s without a lookup every graph gets 10
 more seconds and a sweep never drops the graph being looked up; the results
 do not change

---
 ggml/src/ggml-cuda/common.cuh | 19 ++++++++++++-------
 1 file changed, 12 insertions(+), 7 deletions(-)

diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index 012135d..89a7204 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1537,16 +1537,21 @@ struct ggml_backend_cuda_context {
     // set once by an owner that captures and replays whole tokens itself
     bool graphs_owner_disabled = false;
 
-    int64_t last_graph_eviction_sweep = 0;
+    int64_t next_graph_eviction_time = 0;
+    int64_t last_graph_use_time = 0;
 
-    ggml_cuda_graph * cuda_graph(const void * first_node_ptr) {
-        const int64_t time_now = ggml_time_us();
+    ggml_cuda_graph * cuda_graph(const void * first_node_ptr, int64_t time_now = ggml_time_us()) {
+        // Give all cached graphs 10s to be reused after an idle period, without updating each graph.
+        if (!cuda_graphs.empty() && time_now - last_graph_use_time >= 10'000'000) {
+            next_graph_eviction_time = time_now + 10'000'000;
+        }
+        last_graph_use_time = time_now;
 
-        // sweep every 5s, evicting cuda graphs unused for >=10s
-        if (time_now - last_graph_eviction_sweep >= 5'000'000) {
-            last_graph_eviction_sweep = time_now;
+        // Sweep every 5s during active use, evicting graphs unused for at least 10s.
+        if (time_now >= next_graph_eviction_time) {
+            next_graph_eviction_time = time_now + 5'000'000;
             for (auto it = cuda_graphs.begin(); it != cuda_graphs.end(); ) {
-                if (time_now - it->second->last_used_time >= 10'000'000) {
+                if (it->first != first_node_ptr && time_now - it->second->last_used_time >= 10'000'000) {
                     it = cuda_graphs.erase(it);
                 } else {
                     ++it;
-- 
