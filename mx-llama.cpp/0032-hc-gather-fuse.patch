+// abyss: ABYSS_HC_FUSE, for one token: the gate values from their mixes, the collapse of the residual copies with them
+// (dsv4_hc_pre_f32, not gated) and the rms_norm of the collapse times its weight (rms_norm_f32 with the multiply), in one
+// block of the size and the column order the norm kernel uses, with the same block reduction, so that the gate, the
+// collapse and the norm come out as the separate kernels compute them. Writes all three
+template <int block_size>
+static __global__ void dsv4_hc_pre_norm_f32(
+        const float * gx, const int64_t sgx, const float * gs, const float * gb, const float g_scale, const float g_bias,
+        float * gate, const float * x, const int64_t sx0, const int64_t sx1, const float hc_scale, float * pre,
+        const float * w, float * dst, const int ncols, const float eps) {
+    constexpr int max_per_thread = 8;
+    ggml_cuda_pdl_lc();
+    extern __shared__ float s_sum[];
+    const int tid = threadIdx.x;
+
+    ggml_cuda_pdl_sync();
+
+    float wg[DSV4_HC];
+#pragma unroll
+    for (int ih = 0; ih < DSV4_HC; ++ih) {
+        wg[ih] = dsv4_hc_gate(gx[ih*sgx], gs[0], gb[ih], g_scale, g_bias);
+    }
+    if (tid < DSV4_HC) {
+        gate[tid] = wg[tid];
+    }
+
+    float v[max_per_thread];
+    float tmp = 0.0f;
+#pragma unroll
+    for (int k = 0; k < max_per_thread; ++k) {
+        const int col = tid + k*block_size;
+        if (col < ncols) {
+            float sum = 0.0f;
+#pragma unroll
+            for (int ih = 0; ih < DSV4_HC; ++ih) {
+                sum += x[col*sx0 + ih*sx1] * wg[ih];
+            }
+            v[k] = hc_scale * sum;
+            pre[col] = v[k];
+            tmp += v[k] * v[k];
+        }
+    }
+
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+
+    const float mean  = tmp / ncols;
+    const float scale = rsqrtf(mean + eps);
+
+#pragma unroll
+    for (int k = 0; k < max_per_thread; ++k) {
+        const int col = tid + k*block_size;
+        if (col < ncols) {
+            dst[col] = scale * v[k] * w[col];
+        }
+    }
+}
+
+bool ggml_cuda_should_fuse_dsv4_hc_pre_norm(const ggml_tensor * mul, const ggml_tensor * scale, const ggml_tensor * pre,
+        const ggml_tensor * norm, const ggml_tensor * mul_w) {
+    const ggml_tensor * gx = mul->src[0];
+    const ggml_tensor * x  = pre->src[0];
+    const ggml_tensor * w  = mul_w->src[1];
+    if (pre->src[1] != scale || norm->src[0] != pre || mul_w->src[0] != norm || ggml_get_op_params_i32(pre, 1) != 0) {
+        return false;
+    }
+    for (const ggml_tensor * t : { gx, x, w, scale, pre, norm, mul_w }) {
+        if (t->type != GGML_TYPE_F32) {
+            return false;
+        }
+    }
+    // one token, DSV4_HC copies, a row of the size the norm kernel's block covers
+    const int64_t ncols = x->ne[0];
+    if (gx->ne[0] != DSV4_HC || ggml_nrows(gx) != 1 || x->ne[1] != DSV4_HC || x->ne[2] != 1 || x->ne[3] != 1 ||
+            x->nb[0] != sizeof(float) || !ggml_is_contiguous(scale) || ggml_nelements(scale) != DSV4_HC ||
+            !ggml_is_contiguous(pre) || ggml_nrows(pre) != 1 || pre->ne[0] != ncols ||
+            !ggml_is_contiguous(norm) || !ggml_is_contiguous(mul_w) || !ggml_are_same_shape(pre, mul_w) ||
+            !ggml_is_contiguous(w) || w->ne[0] != ncols || ggml_nrows(w) != 1) {
+        return false;
+    }
+    const int block_size = ncols < 1024 ? 256 : 1024;
+    return ncols <= 8*block_size;
+}
+
+void ggml_cuda_op_dsv4_hc_pre_norm(ggml_backend_cuda_context & ctx, const ggml_tensor * mul, const ggml_tensor * add,
+        const ggml_tensor * scale_node, const ggml_tensor * pre, const ggml_tensor * norm, ggml_tensor * mul_w) {
+    const ggml_tensor * gx = mul->src[0];
+    const ggml_tensor * gs = mul->src[1];
+    const ggml_tensor * gb = add->src[1];
+    const ggml_tensor * x  = pre->src[0];
+    const ggml_tensor * w  = mul_w->src[1];
+
+    float g_scale;
+    float g_bias;
+    memcpy(&g_scale, (const float *) scale_node->op_params + 0, sizeof(float));
+    memcpy(&g_bias,  (const float *) scale_node->op_params + 1, sizeof(float));
+    const float hc_scale = ggml_get_op_params_f32(pre, 0);
+    float eps;
+    memcpy(&eps, norm->op_params, sizeof(float));
+
+    const int     ncols = (int) x->ne[0];
+    const int64_t sgx   = gx->nb[0] / sizeof(float);
+    const int64_t sx0   = x->nb[0] / sizeof(float);
+    const int64_t sx1   = x->nb[1] / sizeof(float);
+
+    cudaStream_t stream = ctx.stream();
+    if (ncols < 1024) {
+        const ggml_cuda_kernel_launch_params params = ggml_cuda_kernel_launch_params(dim3(1, 1, 1), dim3(256, 1, 1), 32*sizeof(float), stream);
+        ggml_cuda_kernel_launch(dsv4_hc_pre_norm_f32<256>, params,
+            (const float *) gx->data, sgx, (const float *) gs->data, (const float *) gb->data, g_scale, g_bias,
+            (float *) scale_node->data, (const float *) x->data, sx0, sx1, hc_scale, (float *) pre->data,
+            (const float *) w->data, (float *) mul_w->data, ncols, eps);
+    } else {
+        const ggml_cuda_kernel_launch_params params = ggml_cuda_kernel_launch_params(dim3(1, 1, 1), dim3(1024, 1, 1), 32*sizeof(float), stream);
+        ggml_cuda_kernel_launch(dsv4_hc_pre_norm_f32<1024>, params,
+            (const float *) gx->data, sgx, (const float *) gs->data, (const float *) gb->data, g_scale, g_bias,
+            (float *) scale_node->data, (const float *) x->data, sx0, sx1, hc_scale, (float *) pre->data,
+            (const float *) w->data, (float *) mul_w->data, ncols, eps);
+    }
+}
+
+// abyss: ABYSS_GATHER_FUSE, see dsv4_gather_kv_nodes: the elements of the keys first, then those of the mask; each
+// converted as get_rows, the cast and the concat convert it
+template <typename c_t, typename m_t>
+static __global__ void dsv4_gather_kv_f16(
+        const half * raw_k, const int64_t n_raw_k, const c_t * comp, const int64_t comp_row, const int32_t * ids,
+        const int64_t n_top, half * k_all, const int64_t D, const int64_t n_k,
+        const half * raw_m, const int64_t n_raw_m, const m_t * m_col, const int64_t m_col_stride, half * kq_mask,
+        const int64_t n_m) {
+    ggml_cuda_pdl_sync();
+    for (int64_t i = (int64_t) blockIdx.x*blockDim.x + threadIdx.x; i < n_k + n_m; i += (int64_t) blockDim.x*gridDim.x) {
+        if (i < n_k) {
+            const int64_t row = i / D;
+            if (row < n_raw_k) {
+                k_all[i] = raw_k[i];
+            } else {
+                const int64_t i0 = i - row*D;
+                k_all[i] = ggml_cuda_cast<half>(ggml_cuda_cast<float>(comp[(int64_t) ids[row - n_raw_k]*comp_row + i0]));
+            }
+        } else {
+            const int64_t j    = i - n_k;
+            const int64_t ncol = n_raw_m + n_top;
+            const int64_t r    = j / ncol;
+            const int64_t c    = j - r*ncol;
+            if (c < n_raw_m) {
+                kq_mask[j] = raw_m[r*n_raw_m + c];
+            } else {
+                kq_mask[j] = ggml_cuda_cast<half>(ggml_cuda_cast<float>(m_col[(int64_t) ids[c - n_raw_m]*m_col_stride]));
+            }
+        }
+    }
+}
+
+static bool dsv4_gather_debug() {
+    static const bool on = getenv("ABYSS_GATHER_DEBUG") != nullptr;
+    return on;
+}
+
+static bool dsv4_gather_kv_check(const dsv4_gather_kv_nodes & g) {
+    const ggml_tensor * comp  = g.k_rows->src[0];
+    const ggml_tensor * ids   = g.k_rows->src[1];
+    const ggml_tensor * raw_k = g.k_all->src[0];
+    const ggml_tensor * m_col = g.m_rows->src[0];
+    const ggml_tensor * raw_m = g.kq_mask->src[0];
+    if ((comp->type != GGML_TYPE_F32 && comp->type != GGML_TYPE_F16) || ids->type != GGML_TYPE_I32 || g.k_rows->type != GGML_TYPE_F32 ||
+            raw_k->type != GGML_TYPE_F16 || g.k_all->type != GGML_TYPE_F16 || raw_m->type != GGML_TYPE_F16 ||
+            g.kq_mask->type != GGML_TYPE_F16 || (m_col->type != GGML_TYPE_F32 && m_col->type != GGML_TYPE_F16)) {
+        return false;
+    }
+    // the same top k for the rows and the mask, one row of ids
+    const ggml_tensor * m_ids = g.m_rows->src[1];
+    if (m_ids->data != ids->data || m_ids->type != GGML_TYPE_I32 || ggml_nelements(m_ids) != ggml_nelements(ids) ||
+            ggml_nrows(ids) != 1 || !ggml_is_contiguous(ids)) {
+        return false;
+    }
+    const int64_t n_top = ids->ne[0];
+    // the compressed rows: a 2-D view of F32 rows; the keys: the window's then the rows, D elements each, contiguous
+    if (comp->ne[2] != 1 || comp->ne[3] != 1 || comp->nb[0] != ggml_type_size(comp->type) || comp->nb[1] % ggml_type_size(comp->type) != 0 ||
+            g.k_rows->ne[0] != comp->ne[0] || g.k_rows->ne[1] != n_top || g.k_all->ne[3] != 1 ||
+            !ggml_is_contiguous(g.k_all) || !ggml_is_contiguous(raw_k) || raw_k->ne[0] != g.k_all->ne[0] ||
+            raw_k->ne[1] != g.k_all->ne[1] || g.k_all->ne[0]*g.k_all->ne[1] != comp->ne[0] ||
+            g.k_all->ne[2] != raw_k->ne[2] + n_top) {
+        return false;
+    }
+    // the mask column: one entry per compressed row; the mask: the window's entries then the rows', every row alike
+    if (m_col->ne[0] != 1 || m_col->ne[2] != 1 || m_col->ne[3] != 1 || m_col->nb[1] % ggml_type_size(m_col->type) != 0 ||
+            g.m_rows->ne[0] != 1 || g.m_rows->ne[1] != n_top || !ggml_is_contiguous(raw_m) ||
+            !ggml_is_contiguous(g.kq_mask) || g.kq_mask->ne[0] != raw_m->ne[0] + n_top ||
+            g.kq_mask->ne[1] != raw_m->ne[1] || g.kq_mask->ne[2] != raw_m->ne[2] || g.kq_mask->ne[3] != raw_m->ne[3]) {
+        return false;
+    }
+    return true;
+}
+
+bool ggml_cuda_should_fuse_dsv4_gather_kv(const dsv4_gather_kv_nodes & g) {
+    const bool ok = dsv4_gather_kv_check(g);
+    static int n_said = 0;
+    if (!ok && dsv4_gather_debug() && n_said < 6) {
+        n_said++;
+        const ggml_tensor * ts[] = { g.k_rows->src[0], g.k_rows->src[1], g.k_rows, g.k_all->src[0], g.k_all, g.m_rows->src[0],
+                                     g.m_rows->src[1], g.m_rows, g.kq_mask->src[0], g.kq_mask };
+        for (const ggml_tensor * t : ts) {
+            fprintf(stderr, "gatherdbg check: %-28.28s %s ne %lld %lld %lld %lld nb %zu %zu %zu %zu contiguous %d\n", t->name,
+                ggml_type_name(t->type), (long long) t->ne[0], (long long) t->ne[1], (long long) t->ne[2], (long long) t->ne[3],
+                t->nb[0], t->nb[1], t->nb[2], t->nb[3], (int) ggml_is_contiguous(t));
+        }
+    }
+    return ok;
+}
+
+void ggml_cuda_op_dsv4_gather_kv(ggml_backend_cuda_context & ctx, const dsv4_gather_kv_nodes & g) {
+    const ggml_tensor * comp  = g.k_rows->src[0];
+    const ggml_tensor * ids   = g.k_rows->src[1];
+    const ggml_tensor * raw_k = g.k_all->src[0];
+    const ggml_tensor * m_col = g.m_rows->src[0];
+    const ggml_tensor * raw_m = g.kq_mask->src[0];
+
+    const int64_t n_top = ids->ne[0];
+    const int64_t D     = g.k_all->ne[0]*g.k_all->ne[1];
+    const int64_t n_k   = ggml_nelements(g.k_all);
+    const int64_t n_m   = ggml_nelements(g.kq_mask);
+
+    const int block_size = 256;
+    const int64_t n_blocks = std::min<int64_t>((n_k + n_m + block_size - 1)/block_size, 65535);
+    const ggml_cuda_kernel_launch_params params = ggml_cuda_kernel_launch_params(dim3((unsigned) n_blocks, 1, 1), dim3(block_size, 1, 1), 0, ctx.stream());
+    auto launch = [&](auto c_tag, auto m_tag) {
+        using c_t = decltype(c_tag);
+        using m_t = decltype(m_tag);
+        ggml_cuda_kernel_launch(dsv4_gather_kv_f16<c_t, m_t>, params,
+            (const half *) raw_k->data, raw_k->ne[2], (const c_t *) comp->data, (int64_t) (comp->nb[1]/sizeof(c_t)),
+            (const int32_t *) ids->data, n_top, (half *) g.k_all->data, D, n_k,
+            (const half *) raw_m->data, raw_m->ne[0], (const m_t *) m_col->data, (int64_t) (m_col->nb[1]/sizeof(m_t)),
+            (half *) g.kq_mask->data, n_m);
+    };
+    if (comp->type == GGML_TYPE_F32) {
+        if (m_col->type == GGML_TYPE_F32) {
+            launch(float(), float());
+        } else {
+            launch(float(), half());
+        }
+    } else {
+        if (m_col->type == GGML_TYPE_F32) {
+            launch(half(), float());
+        } else {
+            launch(half(), half());
+        }
+    }
+}
diff --git a/ggml/src/ggml-cuda/dsv4-hc.cuh b/ggml/src/ggml-cuda/dsv4-hc.cuh
index 2379aae..69c8ce5 100644
--- a/ggml/src/ggml-cuda/dsv4-hc.cuh
+++ b/ggml/src/ggml-cuda/dsv4-hc.cuh
@@ -1,6 +1,123 @@
+#pragma once
+
 #include "common.cuh"
 #include "ggml.h"
 
+static constexpr int DSV4_HC = 4;
+
+// abyss: one hyper-connection gate value, sigmoid(x * s + b) * scale + bias, each step rounded as in the four
+// elementwise kernels it stands for; mul_add_sigmoid_scale_f32 and the fusions of ABYSS_HC_FUSE share it
+static __device__ __forceinline__ float dsv4_hc_gate(const float x, const float s, const float b, const float scale, const float bias) {
+    float v = __fmul_rn(x, s);
+    v = __fadd_rn(v, b);
+    v = 1.0f / (1.0f + expf(-v));
+    return scale * v + bias;
+}
+
+static __device__ __forceinline__ void dsv4_hc_comb_norm_cols(float * comb, float eps) {
+    for (int idst = 0; idst < DSV4_HC; ++idst) {
+        float sum = eps;
+        for (int isrc = 0; isrc < DSV4_HC; ++isrc) {
+            sum += comb[idst + DSV4_HC*isrc];
+        }
+
+        const float inv_sum = 1.0f / sum;
+        for (int isrc = 0; isrc < DSV4_HC; ++isrc) {
+            comb[idst + DSV4_HC*isrc] *= inv_sum;
+        }
+    }
+}
+
+static __device__ __forceinline__ void dsv4_hc_comb_norm_rows(float * comb, float eps) {
+    for (int isrc = 0; isrc < DSV4_HC; ++isrc) {
+        float sum = eps;
+        for (int idst = 0; idst < DSV4_HC; ++idst) {
+            sum += comb[idst + DSV4_HC*isrc];
+        }
+
+        const float inv_sum = 1.0f / sum;
+        for (int idst = 0; idst < DSV4_HC; ++idst) {
+            comb[idst + DSV4_HC*isrc] *= inv_sum;
+        }
+    }
+}
+
+// abyss: the comb of one token, comb[idst + DSV4_HC*isrc], from its comb mixes mix[idx*sm] and bases base[idx*sb]: the
+// affine map, a softmax over dst for each src plus eps, then Sinkhorn normalization; dsv4_hc_comb_f32 and the fused
+// split-K reduce of ABYSS_HC_FUSE share it
+static __device__ __forceinline__ void dsv4_hc_comb_token(
+        const float * mix, const int64_t sm, const float scale_comb, const float * base, const int64_t sb,
+        const float eps, const int32_t n_iter, float * comb) {
+    for (int isrc = 0; isrc < DSV4_HC; ++isrc) {
+        float max = -INFINITY;
+        for (int idst = 0; idst < DSV4_HC; ++idst) {
+            const int idx = idst + DSV4_HC*isrc;
