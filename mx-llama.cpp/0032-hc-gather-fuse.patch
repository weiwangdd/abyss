+// abyss: the keys and the mask of a DeepSeek V4.1 single-token attention with its top-k compressed rows (the graph of
+// mx-llama.cpp/0008, which ABYSS_GATHER_FUSE fuses): get_rows of the compressed rows, cast to F16, concat after the
+// window's keys; get_rows of the mask column, repeat, cast, concat after the window's mask. The two come out side by side
+struct test_dsv4_gather_kv : public test_case {
+    const ggml_type type_comp;
+    const ggml_type type_mask;
+    const int64_t d;      // elements of a key row
+    const int64_t n_comp; // compressed rows
+    const int64_t n_top;
+    const int64_t n_raw;  // window rows
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "DSV4_GATHER_KV";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    std::string vars() override {
+        return VARS_TO_STR6(type_comp, type_mask, d, n_comp, n_top, n_raw);
+    }
+
+    test_dsv4_gather_kv(ggml_type type_comp = GGML_TYPE_F16, ggml_type type_mask = GGML_TYPE_F16, int64_t d = 512,
+            int64_t n_comp = 1024, int64_t n_top = 512, int64_t n_raw = 2048)
+        : type_comp(type_comp), type_mask(type_mask), d(d), n_comp(n_comp), n_top(n_top), n_raw(n_raw) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * comp   = ggml_new_tensor_2d(ctx, type_comp, d, n_comp);
+        ggml_tensor * ids    = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, n_top);
+        ggml_tensor * raw_k  = ggml_new_tensor_3d(ctx, GGML_TYPE_F16, d, 1, n_raw);
+        ggml_tensor * m_full = ggml_new_tensor_2d(ctx, type_mask, n_comp, 1);
+        ggml_tensor * raw_m  = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, n_raw, 1);
+        ggml_set_name(comp, "comp");
+        ggml_set_name(ids, "ids");
+
+        ggml_tensor * k_top = ggml_get_rows(ctx, comp, ids);
+        k_top = ggml_cast(ctx, ggml_reshape_4d(ctx, k_top, d, 1, n_top, 1), GGML_TYPE_F16);
+        ggml_tensor * k_all = ggml_concat(ctx, raw_k, k_top, 2);
+
+        ggml_tensor * m_col = ggml_view_2d(ctx, m_full, 1, n_comp, ggml_element_size(m_full), 0);
+        ggml_tensor * m_top = ggml_reshape_2d(ctx, ggml_get_rows(ctx, m_col, ids), n_top, 1);
+        m_top = ggml_repeat_4d(ctx, m_top, n_top, 1, 1, 1);
+        m_top = ggml_cast(ctx, m_top, GGML_TYPE_F16);
+        ggml_tensor * kq_mask = ggml_concat(ctx, raw_m, m_top, 0);
+
+        // side by side: the keys as rows of d, the mask as rows of d too
+        GGML_ASSERT((n_raw + n_top) % d == 0);
+        ggml_tensor * out = ggml_concat(ctx, ggml_reshape_2d(ctx, k_all, d, n_raw + n_top),
+                ggml_reshape_2d(ctx, kq_mask, d, (n_raw + n_top)/d), 1);
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (ggml_is_view_op(t->op)) {
+                continue;
+            }
+            if (t->type == GGML_TYPE_I32) {
+                std::vector<int> data(ggml_nelements(t));
+                for (size_t i = 0; i < data.size(); i++) {
+                    data[i] = rand() % n_comp;
+                }
+                ggml_backend_tensor_set(t, data.data(), 0, data.size() * sizeof(int));
+            } else {
+                init_tensor_uniform(t);
+            }
+        }
+    }
+};
