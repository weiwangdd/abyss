         GGML_ASSERT(pred == nullptr || (ggml_is_contiguous(pred) && pred->type == GGML_TYPE_I32));
         pc->self->plan_split(pc->il, (const int32_t *) ids->data, n, (int32_t *) dst->data, (int32_t *) dst->data + n,
-            pred ? (const int32_t *) pred->data : nullptr, pred ? ggml_nelements(pred) : 0);
+            pred ? (const int32_t *) pred->data : nullptr, pred ? ggml_nelements(pred) : 0, up ? (int32_t *) dst->data + 2*n : nullptr);
     }
 
     // abyss: the scheduler started a computation on backend: the first one on the device of the predicted layer after
     // its plan computes the planned layer, and the prefetch queued now runs while it does
     void launched(ggml_backend_t backend) {
+        // abyss: ABYSS_MOE_DEFER_UPLOAD, the device started the computation after the plan, which reads the hits
+        if (du_il >= 0 && backend == devices[groups[layers[du_il].ig].id].backend) {
