         if (prefetch > 0) {
             fprintf(stderr, "abyss: moe cache prefetch: %zu experts prefetched (%.2f MiB), %zu read by a plan (%.1f%%)\n",
                 stats_pf.uploaded, stats_pf.bytes/1024.0/1024.0, stats_pf.used,
@@ -1282,8 +1410,12 @@ bool llama_moe_cache::big_used(const ggml_tensor * w, std::vector<bool> & used)
     return pimpl->big_used(w, used);
 }
 
-ggml_tensor * llama_moe_cache::build_plan(ggml_context * ctx, int32_t il, ggml_tensor * ids, ggml_tensor * pred, ggml_tensor * keep) const {
