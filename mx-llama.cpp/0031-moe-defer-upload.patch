+            dev_slots[i] = slots[e] >= 0 && !fresh ? slots[e] : no_zero ? -1 : g.n_slots + (int32_t) (i % n_expert_used);
             cpu_ids[i]   = slots[e] >= 0 ? -1 : e;
+            if (fresh) {
+                up[0] = slots[e];
+                up[1] = (int32_t) i;
+            }
         }
 
         stats & st = n_ids <= 8*n_expert_used ? stats_small : stats_large;
@@ -894,6 +1001,7 @@ struct llama_moe_cache::impl {
     void plan_big(int32_t il, const int32_t * ids, int64_t n_ids, int32_t * dev_ids, int32_t * cpu_tok, int32_t * cpu_exp, int32_t * cpu_dst,
             int32_t * cache_slots) {
         const int32_t n_expert = groups[layers[il].ig].ref[0]->ne[2];
+        flush_defer_up();
         begin_plan(il);
         // abyss: with ABYSS_MOE_BIG_CACHE (cache_slots) the experts the cache holds are computed from their slots on its
