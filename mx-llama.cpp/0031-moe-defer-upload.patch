     }
 
     ggml_backend_t backend(int32_t il) const {
@@ -1062,11 +1176,22 @@ struct llama_moe_cache::impl {
 
     ~impl() {
         log_stats();
-        // abyss: the prefetches still in flight write into the banks
+        // abyss: the prefetches and deferred uploads still in flight write into the banks
         for (device & d : devices) {
             if (d.pf_backend) {
