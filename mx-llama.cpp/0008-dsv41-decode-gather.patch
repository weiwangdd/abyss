diff --git a/src/models/deepseek4.cpp b/src/models/deepseek4.cpp
index a8f489c..e378399 100644
--- a/src/models/deepseek4.cpp
+++ b/src/models/deepseek4.cpp
@@ -745,6 +745,19 @@ static bool dsv41_indexer_on() {
     return on;
 }
 
+// abyss: a single query with the indexer reads its top-k compressed rows directly (ABYSS_DSV41_DECODE_GATHER=1)
+static bool dsv41_decode_gather_on() {
+    static const bool on = [] {
+        const char * e = getenv("ABYSS_DSV41_DECODE_GATHER");
+        const bool v = e != nullptr && atoi(e) != 0;
+        if (v) {
+            LLAMA_LOG_INFO("deepseek41: ABYSS_DSV41_DECODE_GATHER=1, single-token attention gathers its top-k compressed rows\n");
+        }
+        return v;
+    }();
+    return on;
+}
+
 // FP4 (e2m1) quantize-dequantize in blocks of 32 along dim 0, with the power-of-two scale 2^ceil(log2(amax/6)) of the
 // reference's fp4_act_quant. Built from plain ops: the e2m1 grid steps 0.5 up to 2, 1 up to 4 and 2 up to 6, and
 // ggml_round breaks ties away from zero where the hardware rounds to even, which only matters on exact ties.
@@ -1034,6 +1047,7 @@ ggml_tensor * llama_model_deepseek4::graph::build_hca_attention(
 
     ggml_build_forward_expand(gf, q);
     ggml_build_forward_expand(gf, kv);
+    cb(q, "hca_q", il);
 
     const llama_kv_cache_dsv4_raw_context * mctx_raw = inp_attn->mctx;
 
@@ -1057,6 +1071,44 @@ ggml_tensor * llama_model_deepseek4::graph::build_hca_attention(
             hca_k->nb[1], hca_k->nb[2], hca_k->nb[3], 0);
     cb(hca_k, "hca_comp_k", il);
 
+    // abyss: one query sees only its top_k compressed rows. Gather them and their mask entries and attend densely to the
+    // window and those rows, instead of concatenating the whole compressed cache for flash attention to gather from
+    if (top_k && !q_rows && q->ne[2] == 1 && hca_k->ne[3] == 1 && n_hca > top_k->ne[0] && dsv41_decode_gather_on()) {
+        const int64_t n_top = top_k->ne[0];
+        ggml_tensor * ids = ggml_view_1d(ctx0, top_k, n_top, 0);
+
+        ggml_tensor * rows  = ggml_view_2d(ctx0, hca_k, hca_k->ne[0]*hca_k->ne[1], n_hca, hca_k->nb[2], 0);
+        ggml_tensor * k_top = ggml_get_rows(ctx0, rows, ids); // f32
+
+        // the query's mask is row 0, positions it cannot see yet stay -inf
+        ggml_tensor * mask_col = ggml_view_2d(ctx0, inp_hca.kq_mask, 1, n_hca, ggml_element_size(inp_hca.kq_mask), 0);
+        ggml_tensor * mask_top = ggml_reshape_2d(ctx0, ggml_get_rows(ctx0, mask_col, ids), n_top, 1);
+
+        // flash attention takes KV lengths in multiples of 256, the padding rows are zero and masked out
+        ggml_tensor * raw_mask = inp_attn->get_kq_mask();
+        const int64_t n_pad = GGML_PAD(raw_k->ne[2] + n_top, 256) - raw_k->ne[2] - n_top;
+        if (n_pad > 0) {
+            k_top    = ggml_pad(ctx0, k_top, 0, n_pad, 0, 0);
+            mask_top = ggml_concat(ctx0, mask_top, ggml_fill(ctx0, ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_pad, 1), -INFINITY), 0);
+        }
+        k_top = ggml_cast(ctx0, ggml_reshape_4d(ctx0, k_top, hca_k->ne[0], hca_k->ne[1], n_top + n_pad, 1), raw_k->type);
+        mask_top = ggml_repeat_4d(ctx0, mask_top, n_top + n_pad, raw_mask->ne[1], raw_mask->ne[2], raw_mask->ne[3]);
+        mask_top = ggml_cast(ctx0, mask_top, raw_mask->type);
+
+        ggml_tensor * k_all = ggml_concat(ctx0, raw_k, k_top, 2);
+        cb(k_all, "hca_k_top", il);
+        ggml_tensor * kq_mask = ggml_concat(ctx0, raw_mask, mask_top, 0);
+        cb(kq_mask, "hca_kq_mask_top", il);
+
+        ggml_tensor * out = build_attn_mha(q, k_all, k_all, nullptr, kq_mask, sinks, nullptr, 0, kq_scale, il);
+        if (k_rot) {
+            out = llama_mul_mat_hadamard(ctx0, out, k_rot);
+        }
+        cb(out, "attn_hca", il);
+
+        return out;
+    }
+
     ggml_tensor * k_all = ggml_concat(ctx0, raw_k, hca_k, 2);
     cb(k_all, "hca_k_all", il);
 
