 common/common.h       |  3 ++
 include/llama.h       |  8 +++++
 src/llama-context.cpp | 72 +++++++++++++++++++++++++++++++++++++++++++
 src/llama-context.h   | 14 +++++++++
 src/llama-cparams.h   |  3 ++
 src/llama-graph.cpp   | 13 ++++++++
 src/llama-graph.h     |  2 ++
 8 files changed, 117 insertions(+)

