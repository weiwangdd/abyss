index 602cc43..aadc190 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -1565,6 +1565,8 @@ void llm_graph_result::reset() {
     t_layer_inp.resize(LLAMA_MAX_LAYERS + 1);
     std::fill(t_layer_inp.begin(), t_layer_inp.end(), nullptr);
 
+    t_moe_ids.assign(LLAMA_MAX_LAYERS, nullptr);
+
     t_sampled.clear();
     t_sampled_probs.clear();
     t_sampled_logits.clear();
@@ -2451,6 +2453,17 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
     //call early so that topk-moe can be used
     ggml_build_forward_expand(gf, weights);
 
+    // abyss: a copy of the selection kept as an output and read after the graph (cparams.cb_moe_ids). The expert stats
+    // read it through an eval callback before, which cut the graph there: no fused routing, and a sync and a graph
+    // launch per layer. The copy comes after the fused nodes, which must stay together
+    if (cparams.cb_moe_ids && il >= 0 && il < (int) res->t_moe_ids.size() && n_tokens > 0) {
+        ggml_tensor * ids_out = ggml_cont(ctx0, selected_experts);
+        cb(ids_out, "ffn_moe_ids_out", il);
+        ggml_set_output(ids_out);
+        ggml_build_forward_expand(gf, ids_out);
+        res->t_moe_ids[il] = ids_out;
+    }
+
     // the experts of host-resident layers may be read from the MoE cache
     // abyss: the CPU may compute some of the misses, for the plain SwiGLU experts of DeepSeek V4
     const bool cpu_split_ok = (arch == LLM_ARCH_DEEPSEEK4 || arch == LLM_ARCH_DEEPSEEK41) && il >= 0 &&
diff --git a/src/llama-graph.h b/src/llama-graph.h
index 4a4e8a1..a805b19 100644
--- a/src/llama-graph.h
+++ b/src/llama-graph.h
@@ -1007,6 +1007,8 @@ public:
 
     std::vector<ggml_tensor *> t_layer_inp;
 
+    std::vector<ggml_tensor *> t_moe_ids; // [LLAMA_MAX_LAYERS] abyss: each MoE layer's selected experts, for cparams.cb_moe_ids
+
     std::vector<ggml_tensor *> t_sampled;
     std::vector<ggml_tensor *> t_sampled_probs;
     std::vector<ggml_tensor *> t_sampled_logits;
