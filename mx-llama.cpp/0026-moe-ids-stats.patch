+++ b/src/llama-context.h
@@ -479,6 +479,20 @@ private:
 
     copy_experts_info copy_experts;
 
+    // abyss: the MoE selections read back for cparams.cb_moe_ids, handed to it at the next synchronize
+    struct moe_ids_entry {
+        int32_t il;
+        int32_t n_used;
