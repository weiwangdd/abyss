@@ -957,6 +962,66 @@ void llama_context::synchronize() {
     t_compute_start_us = 0;
 }
 
+// abyss: each MoE layer's selected experts (an output of the graph) are copied to a pinned buffer with the logits and
+// handed to cparams.cb_moe_ids at the next synchronize, so a decode waits for nothing more than its logits; the
+// selections of an earlier ubatch still in the buffer are handed over first
+void llama_context::moe_ids_read(const llm_graph_result * res) {
+    size_t nbytes = 0;
+    for (const ggml_tensor * t : res->t_moe_ids) {
+        if (t && ggml_nelements(t) > 0) {
+            nbytes += ggml_nbytes(t);
+        }
+    }
+    if (nbytes == 0) {
+        return;
+    }
+
+    if (!moe_ids_pending.empty()) {
+        ggml_backend_sched_synchronize(sched.get());
+        moe_ids_flush();
+    }
+
+    if (!buf_moe_ids || ggml_backend_buffer_get_size(buf_moe_ids.get()) < nbytes) {
+        // room for a full ubatch, so that the buffer is allocated once
+        const size_t size = std::max(nbytes,
+            (size_t) model.hparams.n_layer() * model.hparams.n_expert_used_max() * cparams.n_ubatch * sizeof(int32_t));
+
+        auto * buft = ggml_backend_cpu_buffer_type();
+        auto * output_dev = model.dev_output();
+        auto * host_buft  = output_dev ? ggml_backend_dev_host_buffer_type(output_dev) : nullptr;
+        if (host_buft) {
+            buft = host_buft;
+        }
+        buf_moe_ids.reset(ggml_backend_buft_alloc_buffer(buft, size));
+        GGML_ASSERT(buf_moe_ids != nullptr);
+    }
+
+    uint8_t * base = (uint8_t *) ggml_backend_buffer_get_base(buf_moe_ids.get());
+    size_t offs = 0;
+    for (size_t il = 0; il < res->t_moe_ids.size(); il++) {
+        ggml_tensor * t = res->t_moe_ids[il];
+        if (!t || ggml_nelements(t) == 0) {
+            continue;
+        }
+        ggml_backend_t backend = ggml_backend_sched_get_tensor_backend(sched.get(), t);
+        GGML_ASSERT(backend != nullptr);
+        ggml_backend_tensor_get_async(backend, t, base + offs, 0, ggml_nbytes(t));
+        moe_ids_pending.push_back({ (int32_t) il, (int32_t) t->ne[0], (int32_t) t->ne[1], offs });
+        offs += ggml_nbytes(t);
+    }
+}
+
+void llama_context::moe_ids_flush() {
+    if (moe_ids_pending.empty()) {
+        return;
+    }
+    const uint8_t * base = (const uint8_t *) ggml_backend_buffer_get_base(buf_moe_ids.get());
+    for (const auto & e : moe_ids_pending) {
+        cparams.cb_moe_ids(e.il, (const int32_t *) (base + e.offs), e.n_used, e.n_tokens, cparams.cb_moe_ids_user_data);
+    }
+    moe_ids_pending.clear();
+}
+
 const llama_model & llama_context::get_model() const {
     return model;
 }
@@ -2453,6 +2518,11 @@ int llama_context::decode(const llama_batch_ext & batch_inp) {
             }
         }
 
+        // abyss: the MoE selections, for cparams.cb_moe_ids
+        if (cparams.cb_moe_ids) {
+            moe_ids_read(res);
+        }
+
         // extract embeddings
         if (embd.data && t_embd && n_outputs > 0) {
             ggml_backend_t backend_embd = ggml_backend_sched_get_tensor_backend(sched.get(), t_embd);
@@ -4701,6 +4771,8 @@ llama_context_params llama_context_default_params() {
         /*.defrag_thold                =*/ -1.0f,
         /*.cb_eval                     =*/ nullptr,
         /*.cb_eval_user_data           =*/ nullptr,
+        /*.cb_moe_ids                  =*/ nullptr,
+        /*.cb_moe_ids_user_data        =*/ nullptr,
         /*.type_k                      =*/ GGML_TYPE_F16,
         /*.type_v                      =*/ GGML_TYPE_F16,
         /*.moe_cache_size              =*/ 0,
