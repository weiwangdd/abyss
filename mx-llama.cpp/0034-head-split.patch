From fb01e331b694ea542013695897aacf503e118c89 Mon Sep 17 00:00:00 2001
From: abyss <abyss@localhost>
Date: Thu, 5 Nov 2026 18:25:09 +0100
Subject: [PATCH] abyss: ABYSS_HEAD_SPLIT=F copies the first F of the output
 head's rows to another GPU at load, with a view of the other rows bound to
 the head's buffer, and the DeepSeek V4 graph computes the logits of a single
 output from both at once, joined by a concat that the context's graph
 callback places on the copy's GPU; the context turns on the scheduler's new
 overlap_gpus with it (ggml_backend_sched_set_overlap_gpus): a GPU split
 without inputs after a split of another GPU does not make the host wait for
 that split, and an input from another GPU is copied on that GPU's stream
 after it has waited on an event of the split backend instead of the host
 waiting; the logits are the same bit for bit

---
 ggml/include/ggml-backend.h |  5 ++++
 ggml/src/ggml-backend.cpp   | 34 +++++++++++++++++++++++--
 src/llama-context.cpp       | 12 +++++++++
 src/llama-model.cpp         | 51 +++++++++++++++++++++++++++++++++++++
 src/llama-model.h           |  4 +++
 src/models/deepseek4.cpp    | 12 ++++++++-
 6 files changed, 115 insertions(+), 3 deletions(-)

diff --git a/ggml/include/ggml-backend.h b/ggml/include/ggml-backend.h
index 37686e1..a5655db 100644
--- a/ggml/include/ggml-backend.h
+++ b/ggml/include/ggml-backend.h
@@ -397,6 +397,11 @@ extern "C" {
     // compute while the GPU does (the MoE expert deferral, ABYSS_MOE_DEFER)
     GGML_API void                 ggml_backend_sched_set_async_host_inputs(ggml_backend_sched_t sched, bool enabled);
 
+    // abyss: with enabled, a GPU split without inputs that follows a split of another GPU does not make the host wait for
+    // that split either: the two GPUs' buffers are apart, and what a split reads of the other GPU is one of its inputs.
+    // The two GPUs can then compute at the same time (the split output head, ABYSS_HEAD_SPLIT)
+    GGML_API void                 ggml_backend_sched_set_overlap_gpus(ggml_backend_sched_t sched, bool enabled);
+
     //
     // Meta backend
     //
diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index 4f03182..43be9c4 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -1041,6 +1041,8 @@ struct ggml_backend_sched {
     void * callback_launch_user_data;
 
     bool async_host_inputs; // abyss: see ggml_backend_sched_set_async_host_inputs
+    bool overlap_gpus;      // abyss: see ggml_backend_sched_set_overlap_gpus
+    ggml_backend_event_t overlap_events[GGML_SCHED_MAX_BACKENDS]; // abyss: for overlap_gpus, made when first needed
 
     char * context_buffer;
     size_t context_buffer_size;
@@ -2386,7 +2388,13 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
         const bool host_goes_on = sched->async_host_inputs && prev_backend_id >= 0 &&
             ggml_backend_dev_type(ggml_backend_get_device(split_backend)) == GGML_BACKEND_DEVICE_TYPE_CPU &&
             ggml_backend_dev_type(ggml_backend_get_device(sched->backends[prev_backend_id])) == GGML_BACKEND_DEVICE_TYPE_GPU;
-        if (split->n_inputs == 0 && prev_backend_id >= 0 && prev_backend_id != split_backend_id && !host_goes_on) {
+        // abyss: with overlap_gpus a GPU split after one of another GPU starts while that one still runs
+        const bool gpu_goes_on = sched->overlap_gpus && prev_backend_id >= 0 &&
+            ggml_backend_dev_type(ggml_backend_get_device(split_backend)) == GGML_BACKEND_DEVICE_TYPE_GPU &&
+            ggml_backend_dev_type(ggml_backend_get_device(sched->backends[prev_backend_id])) == GGML_BACKEND_DEVICE_TYPE_GPU &&
+            ggml_backend_get_device(split_backend) != ggml_backend_get_device(sched->backends[prev_backend_id]);
+        if (split->n_inputs == 0 && prev_backend_id >= 0 && prev_backend_id != split_backend_id && !host_goes_on &&
+                !gpu_goes_on) {
             if (sched->events[prev_backend_id][sched->cur_copy] != NULL) {
                 ggml_backend_event_synchronize(sched->events[prev_backend_id][sched->cur_copy]);
             } else {
@@ -2527,7 +2535,23 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
                 if (sched->sync_non_graph_inputs) {
                     ggml_backend_synchronize(split_backend);
                 }
-                if (sched->events[split_backend_id][sched->cur_copy] != NULL) {
+                // abyss: with overlap_gpus and no events of the copies, an input from another GPU is copied on that GPU's
+                // stream (the CUDA async copy) after the stream has waited, on the GPUs, for the work queued on the split
+                // backend, instead of the host waiting for that work
+                ggml_backend_event_t overlap_event = NULL;
+                if (sched->overlap_gpus && sched->events[split_backend_id][sched->cur_copy] == NULL &&
+                        input_backend != split_backend &&
+                        ggml_backend_dev_type(ggml_backend_get_device(input_backend)) == GGML_BACKEND_DEVICE_TYPE_GPU &&
+                        ggml_backend_dev_type(ggml_backend_get_device(split_backend)) == GGML_BACKEND_DEVICE_TYPE_GPU) {
+                    if (sched->overlap_events[split_backend_id] == NULL) {
+                        sched->overlap_events[split_backend_id] = ggml_backend_event_new(ggml_backend_get_device(split_backend));
+                    }
+                    overlap_event = sched->overlap_events[split_backend_id];
+                }
+                if (overlap_event != NULL) {
+                    ggml_backend_event_record(overlap_event, split_backend);
+                    ggml_backend_event_wait(input_backend, overlap_event);
+                } else if (sched->events[split_backend_id][sched->cur_copy] != NULL) {
                     ggml_backend_event_wait(split_backend, sched->events[split_backend_id][sched->cur_copy]);
                 } else {
                     ggml_backend_synchronize(split_backend);
@@ -2864,6 +2888,7 @@ void ggml_backend_sched_free(ggml_backend_sched_t sched) {
             ggml_backend_event_free(sched->events[b][c]);
             ggml_backend_event_free(sched->input_staging_events[b][c]);
         }
+        ggml_backend_event_free(sched->overlap_events[b]);
     }
     ggml_gallocr_free(sched->galloc);
     ggml_free(sched->ctx);
@@ -3013,6 +3038,11 @@ void ggml_backend_sched_set_async_host_inputs(ggml_backend_sched_t sched, bool e
     sched->async_host_inputs = enabled;
 }
 
+void ggml_backend_sched_set_overlap_gpus(ggml_backend_sched_t sched, bool enabled) {
+    GGML_ASSERT(sched);
+    sched->overlap_gpus = enabled;
+}
+
 int ggml_backend_sched_get_n_splits(ggml_backend_sched_t sched) {
     GGML_ASSERT(sched);
     return sched->n_splits;
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 9036483..9630705 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -747,6 +747,8 @@ void llama_context::sched_reserve() {
             return e != nullptr && atoi(e) != 0;
         }();
         ggml_backend_sched_set_async_host_inputs(result, moe_defer);
+        // abyss: the two halves of the split output head run at the same time (ABYSS_HEAD_SPLIT)
+        ggml_backend_sched_set_overlap_gpus(result, model.output_split != nullptr);
         return result;
     };
 
@@ -3628,6 +3630,16 @@ llm_graph_cb llama_context::graph_get_cb() const {
             ggml_set_name(cur, name);
         }
 
+        // abyss: the split head's logits are joined on the GPU with the copy of its first rows (ABYSS_HEAD_SPLIT)
+        if (il == -1 && cur->op == GGML_OP_CONCAT && model.output_split != nullptr && strcmp(name, "result_output") == 0) {
+            ggml_backend_dev_t dev = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(model.output_split->buffer));
+            for (const auto & backend : backends) {
+                if (ggml_backend_get_device(backend.get()) == dev) {
+                    ggml_backend_sched_set_tensor_backend(sched.get(), cur, backend.get());
+                }
+            }
+        }
+
         // - norm may be automatically assigned to the backend of the previous layer, increasing data transfer between backends
         // - force the last op of the layer on the specified backend to avoid running it on the backend of the next layer due to scheduling
         // FIXME: fix in ggml_backend_sched
diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index bae0067..c7615ff 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -2494,6 +2494,57 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
 
     llama_ple_prefault(per_layer_tok_embd);
 
+    // abyss: ABYSS_HEAD_SPLIT=F copies the first F of the output head's rows to the first other GPU, when the head is on
+    // a GPU; the graph then computes the logits of a single output on both at once, those rows from the copy (deepseek4)
+    if (const char * e = getenv("ABYSS_HEAD_SPLIT"); e != nullptr && output != nullptr && output->buffer != nullptr &&
+            !ggml_backend_buffer_is_host(output->buffer)) {
+        const double frac = atof(e);
+        ggml_backend_dev_t dev_out = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(output->buffer));
+        ggml_backend_dev_t dev_split = nullptr;
+        for (const auto & d : devices) {
+            if (!d.is_meta && d.dev != dev_out && ggml_backend_dev_type(d.dev) == GGML_BACKEND_DEVICE_TYPE_GPU) {
+                dev_split = d.dev;
+                break;
+            }
+        }
+        const int64_t n_rows  = output->ne[1];
+        const int64_t n_split = std::clamp<int64_t>(llround(frac * n_rows), 0, n_rows);
+        if (dev_split != nullptr && n_split > 0 && n_split < n_rows && ggml_is_contiguous(output)) {
+            ggml_init_params ip = { 2*ggml_tensor_overhead(), nullptr, true };
+            ggml_context_ptr ctx(ggml_init(ip));
+            ggml_tensor * t = ggml_new_tensor_2d(ctx.get(), output->type, output->ne[0], n_split);
+            ggml_set_name(t, "output_split.weight");
+            // a view made in the graph has no buffer yet, and the scheduler would place its product by its neighbours
+            ggml_tensor * rest = ggml_view_2d(ctx.get(), output, output->ne[0], n_rows - n_split, output->nb[1],
+                    n_split*output->nb[1]);
+            ggml_set_name(rest, "output_rest.weight");
+            ggml_backend_buffer_ptr buf(ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), ggml_backend_dev_buffer_type(dev_split)));
+            // the allocation also initialises the view, on the head's buffer
+            if (buf && rest->buffer == nullptr) {
+                ggml_backend_view_init(rest);
+            }
+            if (buf && rest->buffer == output->buffer) {
+                ggml_backend_buffer_set_usage(buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+                std::vector<uint8_t> rows(ggml_nbytes(t));
+                ggml_backend_tensor_get(output, rows.data(), 0, rows.size());
+                ggml_backend_tensor_set(t, rows.data(), 0, rows.size());
+                output_split = t;
+                output_rest  = rest;
+                std::vector<ggml_backend_buffer_ptr> bufs;
+                bufs.emplace_back(std::move(buf));
+                pimpl->ctxs_bufs.emplace_back(std::move(ctx), std::move(bufs));
+                // the server does not show info logs of the library
+                fprintf(stderr, "abyss: ABYSS_HEAD_SPLIT=%s, rows 0-%lld of %lld of the output head (%.1f MiB) also on %s\n",
+                        e, (long long) n_split - 1, (long long) n_rows, ggml_nbytes(t) / 1048576.0, ggml_backend_dev_name(dev_split));
+            } else {
+                fprintf(stderr, "abyss: ABYSS_HEAD_SPLIT=%s, could not allocate %.1f MiB on %s, the head is not split\n",
+                        e, ggml_nbytes(t) / 1048576.0, ggml_backend_dev_name(dev_split));
+            }
+        } else {
+            fprintf(stderr, "abyss: ABYSS_HEAD_SPLIT=%s, no other GPU or no rows to split, the head is not split\n", e);
+        }
+    }
+
     return true;
 }
 
diff --git a/src/llama-model.h b/src/llama-model.h
index 9328b57..130c61b 100644
--- a/src/llama-model.h
+++ b/src/llama-model.h
@@ -676,6 +676,10 @@ struct llama_model {
     struct ggml_tensor * output_res_score = nullptr; // kimi-k3: final cross-layer residual mix
     struct ggml_tensor * output_norm_b   = nullptr;
     struct ggml_tensor * output          = nullptr;
+    // abyss: ABYSS_HEAD_SPLIT, a copy of the head's first rows on another GPU and a view of the other rows, bound to the
+    // head's buffer so that the scheduler keeps their product on the head's GPU (llama_model_base::load_tensors)
+    struct ggml_tensor * output_split    = nullptr;
+    struct ggml_tensor * output_rest     = nullptr;
     struct ggml_tensor * output_b        = nullptr;
     struct ggml_tensor * output_norm_enc = nullptr;
 
diff --git a/src/models/deepseek4.cpp b/src/models/deepseek4.cpp
index f3b6ea3..a26f35c 100644
--- a/src/models/deepseek4.cpp
+++ b/src/models/deepseek4.cpp
@@ -2032,7 +2032,17 @@ llama_model_deepseek4::graph::graph(const llama_model & model, const llm_graph_p
     cb(cur, "result_norm", -1);
     res->t_embd = cur;
 
-    cur = ggml_mul_mat(ctx0, model.output, cur);
+    // abyss: ABYSS_HEAD_SPLIT (llama_model::output_split): a single output's logits are computed on two GPUs at once,
+    // the first rows from the copy on the other GPU and the rest on the head's own, and joined on the other GPU (the
+    // context's graph callback puts the concat there, so that neither GPU waits for the other before its own rows);
+    // each row is the same dot product as before
+    if (model.output_split != nullptr && n_outputs == 1) {
+        ggml_tensor * rows_split = ggml_mul_mat(ctx0, model.output_split, cur);
+        ggml_tensor * rows_rest  = ggml_mul_mat(ctx0, model.output_rest, cur);
+        cur = ggml_concat(ctx0, rows_split, rows_rest, 0);
+    } else {
+        cur = ggml_mul_mat(ctx0, model.output, cur);
+    }
     cb(cur, "result_output", -1);
     res->t_logits = cur;
 
-- 
