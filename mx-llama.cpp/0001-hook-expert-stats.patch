Subject: [PATCH] abyss: routed-expert hit counter for llama-server

---
 tools/server/CMakeLists.txt | 2 ++
 tools/server/server.cpp     | 3 +++
 2 files changed, 5 insertions(+)

diff --git a/tools/server/CMakeLists.txt b/tools/server/CMakeLists.txt
index 70b8d7d..037f115 100644
--- a/tools/server/CMakeLists.txt
+++ b/tools/server/CMakeLists.txt
@@ -45,6 +45,8 @@ add_library(${TARGET}
     server-http.h
     server-models.cpp
     server-models.h
+    abyss-expert-stats.cpp
+    abyss-expert-stats.h
 )
 set_target_properties(${TARGET} PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS ON)
 
diff --git a/tools/server/server.cpp b/tools/server/server.cpp
index 871e827..7c76b67 100644
--- a/tools/server/server.cpp
+++ b/tools/server/server.cpp
@@ -1,3 +1,4 @@
+#include "abyss-expert-stats.h"
 #include "server-context.h"
 #include "server-http.h"
 #include "server-models.h"
@@ -113,6 +114,8 @@ int llama_server(int argc, char ** argv) {
         return 1;
     }
 
+    abyss_expert_stats_install(params);
+
     SRV_INF("%s", "initializing ...\n");
 
     llama_backend_init();
