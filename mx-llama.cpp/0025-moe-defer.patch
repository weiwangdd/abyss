          ggml_tensor * gate_exps_s,
          ggml_tensor * down_exps_s,
          ggml_tensor * selected_experts_in,
-         ggml_tensor * moe_pred) const {
+         ggml_tensor * moe_pred,
+         ggml_tensor ** moe_deferred) const {
     const int64_t n_embd   = cur->ne[0];
     const int64_t n_tokens = cur->ne[1];
     const bool weight_before_ffn = arch == LLM_ARCH_LLAMA4; // for llama4, we apply the sigmoid-ed weights before the FFN
@@ -2454,7 +2457,15 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
         gate_exps && up_exps && down_exps && !gate_up_exps && type_op == LLM_FFN_SILU && !weight_before_ffn &&
         !up_exps_b && !gate_exps_b && !down_exps_b && !up_exps_s && !gate_exps_s && !down_exps_s;
     ggml_tensor * cpu_ids = nullptr;
-    ggml_tensor * slots = build_moe_cache_slots(selected_experts, up_exps, gate_exps, down_exps, gate_up_exps, il, cpu_split_ok ? &cpu_ids : nullptr, moe_pred);
+    // abyss: to defer the CPU's experts, the plan carries their input, so the host has it before the device goes on
+    const bool want_defer = moe_deferred != nullptr && cpu_split_ok && n_tokens == 1;
+    ggml_tensor * cur3 = ggml_reshape_3d(ctx0, cur, n_embd, 1, n_tokens);
+    ggml_tensor * slots = build_moe_cache_slots(selected_experts, up_exps, gate_exps, down_exps, gate_up_exps, il,
+        cpu_split_ok ? &cpu_ids : nullptr, moe_pred, want_defer ? cur3 : nullptr);
+    const bool defer = want_defer && cpu_ids != nullptr;
+    if (moe_deferred) {
+        *moe_deferred = nullptr;
+    }
 
     // abyss: a batch too large for the cache splits its experts between the uploads and the CPU (ABYSS_MOE_BIG_SPLIT).
     // The device path below gets the ids of the experts it uploads, -1 for the CPU's; the CPU gets a compact batch of
@@ -2483,11 +2494,12 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
         }
     }
 
-    cur = ggml_reshape_3d(ctx0, cur, n_embd, 1, n_tokens);
+    cur = cur3;
     ggml_tensor * cur_in = cur;
 
     // abyss: the experts the CPU computes, from the host weights, for the rows of x and the experts of ids
-    auto build_cpu_experts = [&](ggml_tensor * x, ggml_tensor * ids) {
+    // deferred ones are not expanded here: the consumer of their sum expands them after the device's next work
+    auto build_cpu_experts = [&](ggml_tensor * x, ggml_tensor * ids, bool expand = true) {
         ggml_tensor * up_c   = ggml_mul_mat_id(ctx0, up_exps,   x, ids);
         ggml_tensor * gate_c = ggml_mul_mat_id(ctx0, gate_exps, x, ids);
         const float limit = hparams.swiglu_clamp_exp[il];
@@ -2498,13 +2510,15 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
             ggml_backend_sched_set_tensor_backend(sched, t, backend_cpu);
         }
         cb(down_c, "ffn_moe_down_cpu", il);
-        ggml_build_forward_expand(gf, down_c);
+        if (expand) {
+            ggml_build_forward_expand(gf, down_c);
+        }
         return down_c;
     };
 
     // with the small-batch plan the CPU's experts are expanded before the device's, so their split runs after the plan
     // started the uploads
-    ggml_tensor * experts_cpu = cpu_ids ? build_cpu_experts(cur_in, cpu_ids) : nullptr; // [n_embd, n_expert_used, n_tokens]
+    ggml_tensor * experts_cpu = cpu_ids ? build_cpu_experts(cur_in, cpu_ids, !defer) : nullptr; // [n_embd, n_expert_used, n_tokens]
 
     if (weight_before_ffn) {
         // repeat cur to [n_embd, n_expert_used, n_tokens]
@@ -2691,7 +2705,7 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
             }
         }
     }
-    if (experts_cpu) {
+    if (experts_cpu && !defer) {
         // each expert is computed on one side, the other side's rows are zero
         experts = ggml_add(ctx0, experts, experts_cpu);
     }
@@ -2752,6 +2766,20 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
         ggml_backend_sched_set_tensor_backend(sched, moe_out, moe_cache->backend(il));
     }
 
+    if (defer) {
+        // abyss: the CPU's experts, weighted and summed on the cache device, which copies their rows when it needs the sum
+        ggml_backend_t dev = moe_cache->backend(il);
+        ggml_tensor * rows = ggml_mul(ctx0, experts_cpu, weights);
+        ggml_backend_sched_set_tensor_backend(sched, rows, dev);
+        ggml_tensor * sum = ggml_view_2d(ctx0, rows, n_embd, n_tokens, rows->nb[2], 0);
+        for (uint32_t i = 1; i < hparams.n_expert_used(il); ++i) {
+            sum = ggml_add(ctx0, sum, ggml_view_2d(ctx0, rows, n_embd, n_tokens, rows->nb[2], i*rows->nb[1]));
+            ggml_backend_sched_set_tensor_backend(sched, sum, dev);
+        }
+        cb(sum, "ffn_moe_deferred", il);
+        *moe_deferred = sum;
+    }
+
     cb(moe_out, "ffn_moe_out", il);
 
     return moe_out;
@@ -2765,7 +2793,8 @@ ggml_tensor * llm_graph_context::build_moe_cache_slots(
          ggml_tensor * gate_up_exps,
                  int   il,
