             ggml_tensor * moe_out = build_moe_ffn(cur,
                     layer.ffn_gate_inp,
                     layer.ffn_up_exps,
@@ -1948,8 +1972,13 @@ llama_model_deepseek4::graph::graph(const llama_model & model, const llm_graph_p
                     nullptr,
