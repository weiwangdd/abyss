From d7b375b8272f6599ce2c7c1e29075032bcb54f55 Mon Sep 17 00:00:00 2001
From: abyss <abyss@localhost>
Date: Tue, 3 Nov 2026 14:49:33 +0100
Subject: [PATCH] abyss: ABYSS_MOE_DEFER=1 defers, for a single token, the
 experts the CPU computes for a cached layer to the next layer: their weighted
 sum joins the residual at the next layer's attention output through the post
 mix of the layer that selected them, so the device computes the cached
 experts and the next layer's attention while the host computes the misses;
 the plan carries the FFN input to the host, and a new scheduler switch,
 ggml_backend_sched_set_async_host_inputs, copies small host inputs of GPU
 splits through pinned staging on the GPU's stream and lets a CPU split
 without inputs go on after a GPU split, so the host does not wait for the
 device

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/include/ggml-backend.h |  6 +++++
 ggml/src/ggml-backend.cpp   | 44 +++++++++++++++++++++++++++++++-
 src/llama-context.cpp       |  7 +++++
 src/llama-graph.cpp         | 51 +++++++++++++++++++++++++++++--------
 src/llama-graph.h           | 12 ++++++---
 src/llama-moe-cache.cpp     | 10 ++++----
 src/llama-moe-cache.h       |  4 ++-
 src/models/deepseek4.cpp    | 33 ++++++++++++++++++++++--
 8 files changed, 144 insertions(+), 23 deletions(-)

diff --git a/ggml/include/ggml-backend.h b/ggml/include/ggml-backend.h
index b964d61..37686e1 100644
--- a/ggml/include/ggml-backend.h
+++ b/ggml/include/ggml-backend.h
@@ -391,6 +391,12 @@ extern "C" {
     // abyss: Set a callback to be called after the computation of each split was started
     GGML_API void                 ggml_backend_sched_set_launch_callback(ggml_backend_sched_t sched, ggml_backend_sched_launch_callback callback, void * user_data);
 
+    // abyss: with enabled, a small input in host memory that a GPU split reads from a CPU split is copied through a
+    // pinned staging buffer on the GPU's stream, after the work queued on it, instead of the host first waiting for the
+    // GPU to finish; and a CPU split without inputs after a GPU split does not wait for that split. The host can then
+    // compute while the GPU does (the MoE expert deferral, ABYSS_MOE_DEFER)
+    GGML_API void                 ggml_backend_sched_set_async_host_inputs(ggml_backend_sched_t sched, bool enabled);
+
     //
     // Meta backend
     //
diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index 8845708..560e053 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -1040,6 +1040,8 @@ struct ggml_backend_sched {
     ggml_backend_sched_launch_callback callback_launch;
     void * callback_launch_user_data;
 
+    bool async_host_inputs; // abyss: see ggml_backend_sched_set_async_host_inputs
+
     char * context_buffer;
     size_t context_buffer_size;
 
@@ -2379,7 +2381,12 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
 
         // ensure the previous split's async work has completed before we start
         // this split, the allocator may have reused buffer regions across splits
-        if (split->n_inputs == 0 && prev_backend_id >= 0 && prev_backend_id != split_backend_id) {
+        // abyss: with async_host_inputs a CPU split goes on while the GPU computes: the GPU splits read no host compute
+        // buffer asynchronously then, their host inputs go through staging buffers
+        const bool host_goes_on = sched->async_host_inputs && prev_backend_id >= 0 &&
+            ggml_backend_dev_type(ggml_backend_get_device(split_backend)) == GGML_BACKEND_DEVICE_TYPE_CPU &&
+            ggml_backend_dev_type(ggml_backend_get_device(sched->backends[prev_backend_id])) == GGML_BACKEND_DEVICE_TYPE_GPU;
+        if (split->n_inputs == 0 && prev_backend_id >= 0 && prev_backend_id != split_backend_id && !host_goes_on) {
             if (sched->events[prev_backend_id][sched->cur_copy] != NULL) {
                 ggml_backend_event_synchronize(sched->events[prev_backend_id][sched->cur_copy]);
             } else {
@@ -2477,6 +2484,36 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
                 }
             } else {
                 sched->timing.n_non_graph_inputs += sched->timing.enabled ? 1 : 0;
+
+                // abyss: async_host_inputs: a small host input of a GPU split from a CPU split is copied on the split
+                // backend's stream, after the work queued on it, so the host does not wait for the GPU here. The pinned
+                // staging buffer keeps the data until the copy has run
+                const size_t async_size = ggml_nbytes(input);
+                if (sched->async_host_inputs && !ggml_backend_sched_is_host_weight(input) && input != input_cpy &&
+                        input->buffer != nullptr && ggml_backend_buffer_is_host(input->buffer) &&
+                        ggml_backend_dev_type(ggml_backend_get_device(input_backend)) == GGML_BACKEND_DEVICE_TYPE_CPU &&
+                        ggml_backend_dev_type(ggml_backend_get_device(split_backend)) == GGML_BACKEND_DEVICE_TYPE_GPU &&
+                        async_size > 0 && async_size <= 1024*1024 && ggml_is_contiguous(input) && ggml_is_contiguous(input_cpy) &&
+                        split_backend->iface.set_tensor_async != nullptr && input_staging_event != nullptr) {
+                    if (!input_staging_event_waited) {
+                        if (sched->input_staging_events_recorded[split_backend_id][sched->cur_copy]) {
+                            ggml_backend_event_synchronize(input_staging_event);
+                        }
+                        sched->input_staging_events_recorded[split_backend_id][sched->cur_copy] = false;
+                        input_staging_event_waited = true;
+                    }
+                    ggml_backend_sched_input_staging * staging = ggml_backend_sched_get_input_staging(
+                        sched, hash_id(input), split_backend_id, sched->cur_copy, async_size);
+                    void * input_staging = ggml_backend_buffer_get_base(staging->buffer);
+                    GGML_ASSERT(input_staging != nullptr);
+                    memcpy(input_staging, input->data, async_size);
+                    ggml_backend_tensor_set_async(split_backend, input_cpy, input_staging, 0, async_size);
+                    input_staging_event_needs_record = true;
+                    sched->timing.n_non_graph_inputs_staged += sched->timing.enabled ? 1 : 0;
+                    ggml_backend_sched_timing_trace_input(sched, "non_graph_async_host", input, input_cpy, input_backend, split_backend);
+                    continue;
+                }
+
                 // wait for the split backend to finish using the input before overwriting it
                 int64_t t0 = ggml_backend_sched_timing_now(sched);
                 // ROCm: with deep pipelining the enqueued event wait below does not
@@ -2967,6 +3004,11 @@ void ggml_backend_sched_set_launch_callback(ggml_backend_sched_t sched, ggml_bac
     sched->callback_launch_user_data = user_data;
 }
 
+void ggml_backend_sched_set_async_host_inputs(ggml_backend_sched_t sched, bool enabled) {
+    GGML_ASSERT(sched);
+    sched->async_host_inputs = enabled;
+}
+
 int ggml_backend_sched_get_n_splits(ggml_backend_sched_t sched) {
     GGML_ASSERT(sched);
     return sched->n_splits;
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index dd47f45..a982d2d 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -737,6 +737,13 @@ void llama_context::sched_reserve() {
         ggml_backend_sched_set_sync_non_graph_inputs(result, sync_non_graph_inputs);
         ggml_backend_sched_set_copy_callback(result, sched_copy_experts, this);
         ggml_backend_sched_set_launch_callback(result, sched_launched, this);
+        // abyss: ABYSS_MOE_DEFER=1 defers the experts the CPU computes for a single token to the next layer, so the
+        // host computes them while the GPU goes on; the scheduler must then not make the host wait for the GPU
+        static const bool moe_defer = [] {
+            const char * e = getenv("ABYSS_MOE_DEFER");
+            return e != nullptr && atoi(e) != 0;
+        }();
+        ggml_backend_sched_set_async_host_inputs(result, moe_defer);
         return result;
     };
 
diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
