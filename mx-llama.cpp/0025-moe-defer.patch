@@ -1815,6 +1815,17 @@ llama_model_deepseek4::graph::graph(const llama_model & model, const llm_graph_p
         return off;
     }();
 
+    // abyss: ABYSS_MOE_DEFER=1, for a single token the experts the CPU computes for a cached layer are added to the
+    // residual only at the next layer's attention output, through the post mix of the layer that selected them: the
+    // host computes them while the device runs the next layer's attention. Exact for the residual, approximate in that
