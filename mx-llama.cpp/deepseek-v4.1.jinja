{#- DeepSeek-V4.1, following the official encoding/encoding.py: the conversation opens with <｜System｜> and, in thinking
    mode, the numeric reasoning effort line; system messages render in place (a mid-conversation one also opens the
    assistant turn, like a user message), "developer" counts as system; tool results merge into the user turn as
    <tool_result> blocks; with tools the reasoning of every assistant turn is kept, without them only after the last
    user message. Request-level tools and response_format go into the first system message, an empty one if there is
    none. reasoning_effort takes low/high/max (50/75/100, official), minimal/medium/xhigh (25/62/88) or 1-100. -#}
{%- if not add_generation_prompt is defined -%}
  {%- set add_generation_prompt = false -%}
{%- endif -%}
{%- if not thinking is defined -%}
  {%- if enable_thinking is defined -%}
    {%- set thinking = enable_thinking -%}
  {%- else -%}
    {%- set thinking = false -%}
  {%- endif -%}
{%- endif -%}
{%- if not drop_thinking is defined -%}
  {%- set drop_thinking = true -%}
{%- endif -%}
{%- set dsml_token = '｜DSML｜' -%}
{%- set thinking_start_token = '<think>' -%}
{%- set thinking_end_token = '</think>' -%}
{%- set tools_header = '## Tools\n\nYou have access to a set of tools to help answer the user\'s question. You can invoke tools by writing a "<' + dsml_token + ' calls>" block like the following:\n\n<' + dsml_token + ' calls>\n<' + dsml_token + ' invoke name="$TOOL_NAME">\n<' + dsml_token + ' parameter name="$PARAMETER_NAME" string="true|false">$PARAMETER_VALUE</' + dsml_token + ' parameter>\n...\n</' + dsml_token + ' invoke>\n<' + dsml_token + ' invoke name="$TOOL_NAME2">\n...\n</' + dsml_token + ' invoke>\n</' + dsml_token + ' calls>\n\nString parameters should be specified as is and set `string="true"`. For all other types (numbers, booleans, arrays, objects), pass the value in JSON format and set `string="false"`.\n\nIf thinking_mode is enabled (triggered by ' + thinking_start_token + '), you MUST output your complete reasoning inside ' + thinking_start_token + '...' + thinking_end_token + ' BEFORE any tool calls or final response.\n\nOtherwise, output directly after ' + thinking_end_token + ' with tool calls or final response.\n\n### Available Tool Schemas\n\n' -%}
{%- set tools_footer = '\n\nYou MUST strictly follow the above defined tool name and parameter schemas to invoke tool calls.\n' -%}
{%- set response_format_header = '## Response Format:\n\nYou MUST strictly adhere to the following schema to reply:\n' -%}

{#- reasoning effort -#}
{%- set effort = namespace(value=75) -%}
{%- if reasoning_effort is defined and reasoning_effort is not none -%}
  {%- set re = reasoning_effort | string -%}
  {%- if re == 'low' -%}{%- set effort.value = 50 -%}
  {%- elif re == 'high' -%}{%- set effort.value = 75 -%}
  {%- elif re == 'max' -%}{%- set effort.value = 100 -%}
  {%- elif re == 'minimal' -%}{%- set effort.value = 25 -%}
  {%- elif re == 'medium' -%}{%- set effort.value = 62 -%}
  {%- elif re == 'xhigh' -%}{%- set effort.value = 88 -%}
  {%- elif (re | int) >= 1 and (re | int) <= 100 -%}{%- set effort.value = re | int -%}
  {%- endif -%}
{%- endif -%}
{%- set effort_prompt = '' -%}
{%- if thinking -%}
  {%- set effort_prompt = 'Reasoning Effort: ' + (effort.value | string) + ' (range 1-100, the higher the value, the more thorough the reasoning)\n\n' -%}
{%- endif -%}

{#- tool schemas and response format, appended to the first system message -#}
{%- set has_tools = tools is defined and tools -%}
{%- set extra = namespace(text='') -%}
{%- if has_tools -%}
  {%- set ts = namespace(schemas=[]) -%}
  {%- for tool in tools -%}
    {%- if tool['type'] == 'function' -%}
      {%- set ts.schemas = ts.schemas + [tool['function'] | tojson] -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set extra.text = '\n\n' + tools_header + (ts.schemas | join('\n')) + tools_footer -%}
{%- endif -%}
{%- if response_format is defined and response_format -%}
  {%- set extra.text = extra.text + '\n\n' + response_format_header + (response_format | tojson) -%}
{%- endif -%}

{#- the last turn that a user starts: a user message (not one that only carries tool results) or a mid-conversation
    system message -#}
{%- set lu = namespace(index=-1) -%}
{%- for message in messages -%}
  {%- set role = 'system' if message['role'] == 'developer' else message['role'] -%}
  {%- if role == 'user' or (role == 'system' and loop.index0 > 0) -%}
    {%- set lu.index = loop.index0 -%}
  {%- endif -%}
{%- endfor -%}
{%- set drop = drop_thinking and not has_tools -%}

{{- bos_token -}}
{%- set first_is_system = messages and messages[0]['role'] in ['system', 'developer'] -%}
{%- if effort_prompt or first_is_system or extra.text -%}
  {{- '<｜System｜>' + effort_prompt -}}
{%- endif -%}
{%- if not first_is_system and extra.text -%}
  {{- extra.text -}}
{%- endif -%}

{%- set st = namespace(in_user=false, user_has_text=false) -%}
{%- for message in messages -%}
  {%- set idx = loop.index0 -%}
  {%- set role = 'system' if message['role'] == 'developer' else message['role'] -%}
  {%- set next_role = none -%}
  {%- if not loop.last -%}
    {%- set next_role = 'system' if messages[idx + 1]['role'] == 'developer' else messages[idx + 1]['role'] -%}
  {%- endif -%}

  {%- if role == 'system' -%}
    {%- set st.in_user = false -%}
    {%- if idx == 0 -%}
      {{- (message['content'] or '') + extra.text -}}
    {%- else -%}
      {{- '<｜System｜>' + (message['content'] or '') -}}
    {%- endif -%}
  {%- elif role == 'user' or role == 'tool' -%}
    {%- if st.in_user -%}
      {{- '\n\n' -}}
    {%- else -%}
      {{- '<｜User｜>' -}}
      {%- set st.in_user = true -%}
    {%- endif -%}
    {%- if role == 'tool' -%}
      {{- '<tool_result>' + (message['content'] or '') + '</tool_result>' -}}
    {%- else -%}
      {{- message['content'] or '' -}}
    {%- endif -%}
  {%- elif role == 'assistant' -%}
    {%- set st.in_user = false -%}
    {%- if thinking and (not drop or idx > lu.index) -%}
      {{- (message['reasoning_content'] or '') + thinking_end_token -}}
    {%- endif -%}
    {{- message['content'] or '' -}}
    {#- written out directly: llama.cpp passes the arguments as objects only to templates that read them -#}
    {%- if message['tool_calls'] -%}
      {{- '\n\n<' + dsml_token + ' calls>\n' -}}
      {%- for tool in message['tool_calls'] -%}
        {%- set func = tool['function'] -%}
        {%- if not loop.first -%}
          {{- '\n' -}}
        {%- endif -%}
        {{- '<' + dsml_token + ' invoke name="' + func['name'] + '">\n' -}}
        {%- if func['arguments'] is string -%}
          {{- '<' + dsml_token + ' parameter name="arguments" string="true">' + func['arguments'] + '</' + dsml_token + ' parameter>' -}}
        {%- else -%}
          {%- for key, val in func['arguments'].items() -%}
            {%- if not loop.first -%}
              {{- '\n' -}}
            {%- endif -%}
            {%- if val is string -%}
              {{- '<' + dsml_token + ' parameter name="' + key + '" string="true">' + val + '</' + dsml_token + ' parameter>' -}}
            {%- else -%}
              {{- '<' + dsml_token + ' parameter name="' + key + '" string="false">' + (val | tojson) + '</' + dsml_token + ' parameter>' -}}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {{- '\n</' + dsml_token + ' invoke>' -}}
      {%- endfor -%}
      {{- '\n</' + dsml_token + ' calls>' -}}
    {%- endif -%}
    {{- '<｜end▁of▁sentence｜>' -}}
  {%- endif -%}

  {#- a user turn (or a mid-conversation system message) followed by the assistant or by nothing opens the assistant
      turn: with <think> in thinking mode, unless thinking is dropped for the turns before the last user turn -#}
  {%- set opens_turn = (role in ['user', 'tool'] or (role == 'system' and idx > 0)) and (next_role == 'assistant' or (loop.last and add_generation_prompt)) -%}
  {%- if opens_turn -%}
    {%- set st.in_user = false -%}
    {{- '<｜Assistant｜>' -}}
    {%- if thinking and (not drop or idx >= lu.index) -%}
      {{- thinking_start_token -}}
    {%- else -%}
      {{- thinking_end_token -}}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
