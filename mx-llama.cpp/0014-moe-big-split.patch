diff --git a/ggml/src/ggml-cuda/mmid.cu b/ggml/src/ggml-cuda/mmid.cu
index 12ae14c..4fa0dc2 100644
--- a/ggml/src/ggml-cuda/mmid.cu
+++ b/ggml/src/ggml-cuda/mmid.cu
@@ -177,3 +177,51 @@ void ggml_cuda_launch_mm_ids_helper(
             break;
     }
 }
+
+// abyss: mm_ids_helper counts the ids < 0 below every expert, so they take the compact rows before expert 0's, which no
+// expert multiplies. Their src1 rows (or, for the inverse map, the compact row of a negative slot) are left unset;
+// point them at row 0, which is one of those unused rows whenever an id is negative, so the quantization reads valid
+// memory.
+static __global__ void mm_ids_fix_negative(
+        const int32_t * __restrict__ ids, int32_t * __restrict__ ids_src1, const int32_t * __restrict__ expert_bounds,
+        const int n_tokens, const int n_expert_used, const int si1, const bool write_inverse) {
+    const int i = blockIdx.x*blockDim.x + threadIdx.x;
+    if (i >= n_tokens*n_expert_used) {
+        return;
+    }
+    if (write_inverse) {
+        if (ids[(i / n_expert_used)*si1 + i % n_expert_used] < 0) {
+            ids_src1[i] = 0;
+        }
+    } else if (i < expert_bounds[0]) {
+        ids_src1[i] = 0;
+    }
+}
+
+void ggml_cuda_launch_mm_ids_fix_negative(
+        const int32_t * ids, int32_t * ids_src1, const int32_t * expert_bounds,
+        const int n_tokens, const int n_expert_used, const int si1, const bool write_inverse, cudaStream_t stream) {
+    const int n = n_tokens*n_expert_used;
+    mm_ids_fix_negative<<<(n + 255)/256, 256, 0, stream>>>(ids, ids_src1, expert_bounds, n_tokens, n_expert_used, si1, write_inverse);
+}
+
+// abyss: a block per token slot, the slots of ids < 0 get zero rows
+static __global__ void mm_ids_zero_negative(
+        const int32_t * __restrict__ ids, float * __restrict__ dst, const int n_expert_used, const int si1,
+        const int64_t ne0, const int64_t s1, const int64_t s2) {
+    const int it  = blockIdx.x / n_expert_used;
+    const int iex = blockIdx.x % n_expert_used;
+    if (ids[it*si1 + iex] >= 0) {
+        return;
+    }
+    float * row = dst + it*s2 + iex*s1;
+    for (int64_t i = threadIdx.x; i < ne0; i += blockDim.x) {
+        row[i] = 0.0f;
+    }
+}
+
+void ggml_cuda_launch_mm_ids_zero_negative(
+        const int32_t * ids, float * dst, const int n_tokens, const int n_expert_used, const int si1,
+        const int64_t ne0, const int64_t s1, const int64_t s2, cudaStream_t stream) {
+    mm_ids_zero_negative<<<n_tokens*n_expert_used, 128, 0, stream>>>(ids, dst, n_expert_used, si1, ne0, s1, s2);
+}
