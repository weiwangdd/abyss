@@ -313,8 +313,10 @@ void llm_graph_input_ced::set_input(const llama_ubatch * ubatch) {
 
     const auto & batch_idxs = ubatch->data->batch_idxs;
 
+    // abyss: the lists are made up front, and one the graph does not read is never allocated, for example the
+    // candidate source's map below 2,048 compressed blocks
     for (size_t il = 0; il < idx.size(); ++il) {
-        if (idx[il] == nullptr) {
+        if (idx[il] == nullptr || idx[il]->buffer == nullptr) {
             continue;
         }
 
@@ -333,6 +335,9 @@ void llm_graph_input_ced::set_input(const llama_ubatch * ubatch) {
     // both subsets keep token order and il's sits inside src's, so the rank inside src's counts up as il's go by
     for (const auto & [key, map] : maps) {
         const auto [il, src] = key;
+        if (map->buffer == nullptr) {
+            continue;
+        }
         GGML_ASSERT(ggml_backend_buffer_is_host(map->buffer));
         int32_t * data = (int32_t *) map->data;
 
@@ -2459,6 +2464,10 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
         const float limit = hparams.swiglu_clamp_exp[il];
         ggml_tensor * act_c  = limit > 1e-6f ? ggml_swiglu_clamp(ctx0, gate_c, up_c, limit) : ggml_swiglu_split(ctx0, gate_c, up_c);
         experts_cpu = ggml_mul_mat_id(ctx0, down_exps, act_c, cpu_ids); // [n_embd, n_expert_used, n_tokens]
+        // a batch of 32 would otherwise be offloaded to a GPU, whose kernels do not skip the -1 ids
+        for (ggml_tensor * t : { up_c, gate_c, act_c, experts_cpu }) {
+            ggml_backend_sched_set_tensor_backend(sched, t, backend_cpu);
+        }
         cb(experts_cpu, "ffn_moe_down_cpu", il);
         ggml_build_forward_expand(gf, experts_cpu);
     }
