     fprintf(stderr, "abyss: decode stats, %d tokens: %.1f ms/token, expert cache hit rate %.1f%%, per token %.1f hits, "
-        "%.1f uploaded, %.1f by the CPU, %.1f major page faults\n", decode_stats_n, w.t_us/1000.0/n,
-        used > 0 ? 100.0*w.hits/used : 0.0, w.hits/n, w.up/n, w.cpu/n, w.majflt/n);
+        "%.1f uploaded, %.1f by the CPU, %.1f major page faults%s\n", decode_stats_n, w.t_us/1000.0/n,
+        used > 0 ? 100.0*w.hits/used : 0.0, w.hits/n, w.up/n, w.cpu/n, w.majflt/n, pf);
     w = {};
     decode_stats_n = 0;
 }
@@ -3435,6 +3443,14 @@ ggml_status llama_context::graph_compute(
     return status;
 }
 
+// abyss: the MoE cache issues the prefetch it planned once the device has started computing the planned layer
+void llama_context::sched_launched(ggml_backend_t backend, void * user_data) {
+    auto * lctx = static_cast<llama_context *>(user_data);
+    if (lctx->moe_cache) {
+        lctx->moe_cache->launched(backend);
+    }
+}
