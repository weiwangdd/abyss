diff --git a/src/llama-moe-cache.cpp b/src/llama-moe-cache.cpp
index 597ea38..9288f14 100644
--- a/src/llama-moe-cache.cpp
+++ b/src/llama-moe-cache.cpp
@@ -165,6 +165,10 @@ struct llama_moe_cache::impl {
         ggml_context_ptr ctx;
         ggml_backend_buffer_ptr buf;
         size_t buf_size = 0;
+
+        // abyss: ABYSS_MOE_PREFETCH, a second backend of the device for the stream of the prefetches
+        ggml_backend_t pf_backend = nullptr;
+        bool pf_inflight = false; // prefetches issued since the last evaluation started
     };
 
     // layers of the same device with the same expert tensor layout share the banks and the LRU of a group
@@ -177,6 +181,12 @@ struct llama_moe_cache::impl {
         int32_t n_slots = 0;
         moe_cache_lru lru;
         double admit_acc = 0.0; // carries the fraction of a miss to admit between plans
+
+        // abyss: ABYSS_MOE_PREFETCH, per slot: the evaluation that last planned a read of it and the one that last
+        // prefetched into it, and whether it holds a prefetched expert no plan has read yet
+        std::vector<uint32_t> use_eval;
+        std::vector<uint32_t> pf_eval;
+        std::vector<uint8_t>  pf_unread;
     };
 
     struct layer {
@@ -231,6 +241,25 @@ struct llama_moe_cache::impl {
     std::vector<std::vector<int32_t>> big_dev; // [n_layer] the uploaded experts' ids of the last plan
     std::vector<int> big_pending;              // [n_layer] its host weights not copied yet
 
+    // abyss: ABYSS_MOE_PREFETCH=K, the plan of a single-token batch also uploads, on the prefetch stream of the device,
+    // the top K experts predicted for the next layer that the cache does not hold (see llama_moe_cache::prefetch_k), at
+    // most ABYSS_MOE_PREFETCH_MAX of them (default K). The plan keeps the prediction, and launched() issues the uploads
+    // once the scheduler has started the next computation on the device
+    int32_t prefetch     = 0;
+    int32_t prefetch_max = 0;
+    int32_t pf_next_il   = -1; // the layer the last plan predicted, its experts in pf_next
+    std::vector<int32_t> pf_next;
+    std::vector<ggml_backend_event_t> pf_done; // [n_layer] recorded on the prefetch stream after the layer's prefetch
+    std::vector<uint8_t> pf_pending;           // [n_layer] the device must wait for pf_done before it reads the slots
+    uint32_t eval    = 0;                      // counts the evaluations, see begin_plan
+    int32_t  last_il = INT32_MAX;              // the layer of the last plan
+    std::vector<moe_cache_lru::fill> pf_fills;
+    struct {
+        size_t uploaded = 0;
+        size_t used     = 0; // read by a plan before they were evicted
+        size_t bytes    = 0;
+    } stats_pf;
+
     static constexpr int64_t max_batch = 32;
 
     int32_t n_expert_used;
@@ -288,6 +317,13 @@ struct llama_moe_cache::impl {
         if (const char * e = getenv("ABYSS_MOE_BIG_CACHE")) {
             big_cache = atoi(e) != 0;
         }
+        if (const char * e = getenv("ABYSS_MOE_PREFETCH")) {
+            prefetch = std::clamp(atoi(e), 0, 64);
+        }
+        prefetch_max = prefetch;
+        if (const char * e = getenv("ABYSS_MOE_PREFETCH_MAX")) {
+            prefetch_max = std::clamp(atoi(e), 1, std::max(prefetch, 1));
+        }
         plan_ctxs.resize(model.layers.size());
         big_dev.resize(model.layers.size());
         big_pending.assign(model.layers.size(), 0);
@@ -535,16 +571,148 @@ struct llama_moe_cache::impl {
         if (split) {
             LLAMA_LOG_INFO("%s: ABYSS_MOE_CPU_MISS=1, admitting %.2f of the misses, heat decay %.3f\n", __func__, admit, heat_decay);
         }
+
+        // abyss: the plans issue the prefetches, which ABYSS_MOE_CPU_MISS enables
+        if (!split || model.hparams.no_alloc) {
+            prefetch = 0;
+        }
+        if (prefetch > 0) {
+            init_prefetch();
+        }
+    }
+
+    // abyss: a second backend and the events for the prefetch stream of each device that caches layers
+    void init_prefetch() {
+        pf_done.assign(layers.size(), nullptr);
+        pf_pending.assign(layers.size(), 0);
+        for (group & g : groups) {
+            if (g.n_slots == 0) {
+                continue;
+            }
+            device & d = devices[g.id];
+            ggml_backend_dev_t dev = ggml_backend_get_device(d.backend);
+            if (d.pf_backend == nullptr) {
+                d.pf_backend = ggml_backend_dev_init(dev, nullptr);
+            }
+            bool ok = d.pf_backend != nullptr;
+            for (int32_t il : g.layers) {
+                pf_done[il] = ok ? ggml_backend_event_new(dev) : nullptr;
+                ok = ok && pf_done[il] != nullptr;
+            }
+            if (!ok) {
+                LLAMA_LOG_WARN("%s: %s has no second stream or no events, ABYSS_MOE_PREFETCH is disabled\n", __func__, ggml_backend_dev_name(dev));
+                prefetch = 0;
+                return;
+            }
+            g.use_eval.assign(g.n_slots, 0);
+            g.pf_eval.assign(g.n_slots, 0);
+            g.pf_unread.assign(g.n_slots, 0);
+        }
+        // the server does not show info logs of the library
+        fprintf(stderr, "abyss: ABYSS_MOE_PREFETCH=%d, the plans prefetch the top %d experts predicted for the next layer, at most %d per layer\n",
+            prefetch, prefetch, prefetch_max);
+    }
+
+    // abyss: a plan of a layer at or before the last planned one starts the next evaluation. The prefetches of the last
+    // one are done by then, so none is in flight while this one plans, whatever its batch
+    void begin_plan(int32_t il) {
+        const bool next = il <= last_il;
+        last_il = il;
+        if (!next) {
+            return;
+        }
+        eval++;
+        if (prefetch == 0) {
+            return;
+        }
+        pf_next_il = -1;
+        for (device & d : devices) {
+            if (d.pf_inflight) {
+                ggml_backend_synchronize(d.pf_backend);
+                d.pf_inflight = false;
+            }
+        }
+        std::fill(pf_pending.begin(), pf_pending.end(), 0);
+    }
+
+    // abyss: uploads, on the prefetch stream, the experts of pred (layer il) that the cache does not hold, into the least
+    // recently used slots; the plan of layer il makes the device wait for them
+    void prefetch_layer(int32_t il, const int32_t * pred, int64_t n_pred) {
+        if (il >= (int32_t) layers.size() || layers[il].ig < 0) {
+            return;
+        }
+        const layer & l = layers[il];
+        group & g = groups[l.ig];
+        device & d = devices[g.id];
+        moe_cache_lru & lru = g.lru;
+        int32_t * slots = lru.slot_map[il];
+
+        pf_fills.clear();
+        for (int64_t i = 0; i < n_pred && (int32_t) pf_fills.size() < prefetch_max; ++i) {
+            const int32_t e = pred[i];
+            GGML_ASSERT(e >= 0 && e < lru.n_expert);
+            if (slots[e] >= 0) {
+                continue;
+            }
+            // the uploads below are not ordered after the device's work: the slots planned in this evaluation may still
+            // be read, the others were last read by an evaluation that has finished
+            const int32_t s = lru.head;
+            if (g.use_eval[s] == eval) {
+                break;
+            }
+            if (lru.key_of[s] >= 0) {
+                lru.slot_map[lru.key_of[s] / lru.n_expert][lru.key_of[s] % lru.n_expert] = -1;
+            }
+            lru.key_of[s] = il*lru.n_expert + e;
+            slots[e] = s;
+            lru.touch(s);
+            g.use_eval[s]  = eval;
+            g.pf_eval[s]   = eval;
+            g.pf_unread[s] = 1;
+            pf_fills.push_back({ e, s });
+        }
+        if (pf_fills.empty()) {
+            return;
+        }
+
+        for (size_t ip = 0; ip < l.experts.size(); ++ip) {
+            const ggml_tensor * w    = l.experts[ip];
+            ggml_tensor       * bank = g.banks[ip];
+            const size_t expert_size = w->nb[2];
