From 785586e9e1242650c8a7c05c39ea692abcfc15ce Mon Sep 17 00:00:00 2001
From: abyss <abyss@localhost>
Date: Tue, 3 Nov 2026 13:13:44 +0100
Subject: [PATCH] abyss: ABYSS_MOE_PREFETCH=K makes the plan of a single-token
 batch of each cached layer prefetch, on a second stream of the cache device,
 the top K experts that the next layer's router picks from this layer's router
 input and that the cache does not hold, at most ABYSS_MOE_PREFETCH_MAX of
 them; a new scheduler launch callback issues the uploads once the device has
 started computing the layer, so they do not hold up its input copies, and the
 next layer's plan makes the device wait for them. The decode stats report the
 prefetched experts and how many a plan read

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/include/ggml-backend.h |   7 +
 ggml/src/ggml-backend.cpp   |  13 ++
 src/llama-context.cpp       |  20 ++-
 src/llama-context.h         |   3 +
 src/llama-graph.cpp         |  22 ++-
 src/llama-graph.h           |  14 +-
 src/llama-moe-cache.cpp     | 258 ++++++++++++++++++++++++++++++++++--
 src/llama-moe-cache.h       |  16 ++-
 src/models/deepseek4.cpp    |  22 ++-
 9 files changed, 351 insertions(+), 24 deletions(-)

diff --git a/ggml/include/ggml-backend.h b/ggml/include/ggml-backend.h
index 34bce74..b964d61 100644
--- a/ggml/include/ggml-backend.h
+++ b/ggml/include/ggml-backend.h
@@ -343,6 +343,10 @@ extern "C" {
     // `graph` is the compute graph of the split
     typedef bool (*ggml_backend_sched_copy_callback)(ggml_backend_t backend, const struct ggml_tensor * src, struct ggml_tensor * dst, struct ggml_cgraph * graph, void * user_data);
 
+    // abyss: called after the scheduler started the computation of a split on its backend, from the thread that drives
+    // the graph; the inputs of the split were copied before, so work queued now on the backend's device comes after them
+    typedef void (*ggml_backend_sched_launch_callback)(ggml_backend_t backend, void * user_data);
+
     // Initialize a backend scheduler, backends with low index are given priority over backends with high index
     GGML_API ggml_backend_sched_t ggml_backend_sched_new(ggml_backend_t * backends, ggml_backend_buffer_type_t * bufts, int n_backends, size_t graph_size, bool parallel, bool op_offload);
     GGML_API void                 ggml_backend_sched_free(ggml_backend_sched_t sched);
@@ -384,6 +388,9 @@ extern "C" {
     // Set a callback to be called when the inputs weights of a split are being copied
     GGML_API void                 ggml_backend_sched_set_copy_callback(ggml_backend_sched_t sched, ggml_backend_sched_copy_callback callback, void * user_data);
 
+    // abyss: Set a callback to be called after the computation of each split was started
+    GGML_API void                 ggml_backend_sched_set_launch_callback(ggml_backend_sched_t sched, ggml_backend_sched_launch_callback callback, void * user_data);
+
     //
     // Meta backend
     //
