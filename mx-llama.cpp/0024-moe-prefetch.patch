     // abyss: a batch too large for the cache splits its experts between the uploads and the CPU (ABYSS_MOE_BIG_SPLIT).
     // The device path below gets the ids of the experts it uploads, -1 for the CPU's; the CPU gets a compact batch of
@@ -2761,7 +2764,8 @@ ggml_tensor * llm_graph_context::build_moe_cache_slots(
          ggml_tensor * down_exps,
