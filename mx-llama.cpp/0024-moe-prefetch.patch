@@ -2707,6 +2710,10 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
             }
         }
 
+        if (sched->callback_launch != NULL) {
+            sched->callback_launch(split_backend, sched->callback_launch_user_data);
+        }
+
         // record the event of this split
         if (sched->events[split_backend_id][sched->cur_copy] != NULL) {
             const int64_t t0 = ggml_backend_sched_timing_now(sched);
@@ -2954,6 +2961,12 @@ void ggml_backend_sched_set_copy_callback(ggml_backend_sched_t sched, ggml_backe
     sched->callback_copy_user_data = user_data;
 }
 
+void ggml_backend_sched_set_launch_callback(ggml_backend_sched_t sched, ggml_backend_sched_launch_callback callback, void * user_data) {
+    GGML_ASSERT(sched);
+    sched->callback_launch = callback;
+    sched->callback_launch_user_data = user_data;
+}
