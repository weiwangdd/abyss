+// abyss: background prefetch of the Engram rows a batch is about to gather.
+// The rows depend only on the tokens, so a whole prompt's rows are known as soon as llama_decode() gets it, long before each ubatch gathers them.
+// MADV_WILLNEED makes the kernel start all those reads at once, where the gather would fault them in one page per thread at a time.
+// ABYSS_ENGRAM_PREFETCH sets how many threads issue it; 0, the default, turns it off.
+struct llama_engram_prefetcher {
+    std::vector<std::thread> workers;
+    std::atomic<bool> stop { false };
+
+    // a prefetch still running belongs to an older batch, so it is cut short
+    void join() {
+        stop = true;
+        for (auto & worker : workers) {
+            worker.join();
+        }
+        workers.clear();
+        stop = false;
+    }
+
+    ~llama_engram_prefetcher() {
+        join();
+    }
+};
+
+void llama_model_deepseek41::engram_prefetch(const llama_batch & batch) const {
+    static const int n_threads = [] {
+        const char * e = getenv("ABYSS_ENGRAM_PREFETCH");
+        return e != nullptr ? std::max(0, std::min(64, atoi(e))) : 0;
+    }();
+
+    const auto & hp = hparams;
+
+    // a decode step gathers its few rows right away, so only prompts gain from reading ahead
+    if (n_threads == 0 || hp.engram_n_layers == 0 || engram_token_map.empty() || batch.token == nullptr || batch.pos == nullptr ||
+            batch.n_tokens < 64) {
+        return;
+    }
+
+    // one sequence with consecutive positions, so the batch itself holds every look-back but the first few
+    for (int32_t i = 0; i < batch.n_tokens; ++i) {
+        if (batch.n_seq_id[i] != 1 || batch.seq_id[i][0] != batch.seq_id[0][0] || (i > 0 && batch.pos[i] != batch.pos[i - 1] + 1)) {
+            return;
+        }
+    }
+
+    const int64_t n_gram = hp.engram_max_ngram_size;
+    const int64_t n_cols = hp.engram_n_hash_cols();
+    const int64_t n_eng  = hp.engram_n_layers;
+
+    std::vector<const ggml_tensor *> tables(n_eng);
+    for (int64_t e = 0; e < n_eng; ++e) {
+        tables[e] = layers[hp.engram_layer_ids[e]].engram_embed;
+        if (!tables[e] || !tables[e]->data || !tables[e]->buffer || !ggml_backend_buffer_is_host(tables[e]->buffer)) {
+            return;
+        }
+    }
+
+    if (!engram_prefetcher) {
+        engram_prefetcher = std::make_shared<llama_engram_prefetcher>();
+    }
+    engram_prefetcher->join();
+
+    const int64_t n_vocab_map = (int64_t) engram_token_map.size();
+    auto compress = [&](llama_token t) -> int64_t {
+        return t >= 0 && t < n_vocab_map ? (int64_t) engram_token_map[t] : 0;
+    };
+
+    // the first n_gram - 1 tokens look back into earlier batches, so their rows are left to the gather
+    llama_memory_ranges mr;
+    mr.reserve((size_t) (std::max<int64_t>(0, batch.n_tokens - n_gram + 1)*n_cols*n_eng));
+    std::vector<int64_t> tok(n_gram);
+    std::vector<int32_t> rows(n_cols*n_eng);
+    for (int64_t i = n_gram - 1; i < batch.n_tokens; ++i) {
+        for (int64_t s = 0; s < n_gram; ++s) {
+            tok[s] = compress(batch.token[i - s]);
+        }
+        engram_hash_token(hp, tok.data(), rows.data(), n_cols);
+        for (int64_t e = 0; e < n_eng; ++e) {
+            const auto * base = (const uint8_t *) tables[e]->data;
+            for (int64_t c = 0; c < n_cols; ++c) {
+                mr.push_back({ base + (size_t) rows[e*n_cols + c]*tables[e]->nb[1], (size_t) tables[e]->nb[1] });
+            }
+        }
+    }
+
+    // contiguous address slices, so no two threads advise the same page, in small steps so a newer batch stops them early
+    std::sort(mr.begin(), mr.end(), [](const llama_memory_range & a, const llama_memory_range & b) {
+        return (uintptr_t) a.addr < (uintptr_t) b.addr;
+    });
+    auto ranges = std::make_shared<const llama_memory_ranges>(std::move(mr));
+    llama_engram_prefetcher * pf = engram_prefetcher.get();
+    const size_t n = ranges->size();
+    for (int t = 0; t < n_threads; ++t) {
+        const size_t i0 = n*t/n_threads;
+        const size_t i1 = n*(t + 1)/n_threads;
+        pf->workers.emplace_back([pf, ranges, i0, i1] {
+            constexpr size_t step = 4096;
+            for (size_t i = i0; i < i1 && !pf->stop; i += step) {
+                llama_prefetch(llama_memory_ranges(ranges->begin() + i, ranges->begin() + std::min(i1, i + step)));
+            }
+        });
+    }
+}
