+// abyss: CED-aware prefill (DeepSeek V4.1).
+// The decoder layers read their long-range context from the compressed KV that the first decoder layer builds from the
+// encoder output, and see the other tokens' own hidden states only through sliding windows of n_swa positions, each
+// reaching n_swa - 1 positions back. So a decoder layer needs a token's FFN only where an output token reaches it
+// through the windows of the layers above, or where the next decode step does: the last positions of each sequence
+// stay valid up to the second-to-last layer, ABYSS_CED_MARGIN (256) of them on top of the window, so the short
+// rollbacks the cache allows still find correct sliding-window KV. Tokens out of reach keep their attention, so every
+// KV write is unchanged, and skip the FFN: their wrong hidden states only feed KV entries no later token reads.
+// Each llama_decode() call is planned on its own end, so a prompt split across calls stays correct and only saves less.
+bool llama_context::ced_plan(const llama_batch & batch) {
+    static const bool enabled = [] {
+        const char * e = getenv("ABYSS_CED_PREFILL");
+        return e != nullptr && atoi(e) != 0;
+    }();
+    static const int32_t margin = [] {
+        const char * e = getenv("ABYSS_CED_MARGIN");
+        return e != nullptr ? std::max(0, atoi(e)) : 256;
+    }();
+
+    const auto & hparams = model.hparams;
+    const int32_t n_layer = (int32_t) hparams.n_layer();
+
+    if (!enabled || model.arch != LLM_ARCH_DEEPSEEK41 || hparams.n_swa < 2 || n_layer > INT8_MAX ||
+            cparams.embeddings_nextn || cparams.embeddings_nextn_masked ||
+            std::any_of(cparams.embeddings_layer_inp.begin(), cparams.embeddings_layer_inp.end(), [](bool tap) { return tap; })) {
+        return false;
+    }
+
+    // the first decoder layer is the kv source of the last layer
+    const int32_t first_dec = hparams.dsv41_kv_source_for(n_layer - 1);
+    if (first_dec <= 0 || batch.pos == nullptr || batch.logits == nullptr || batch.embd != nullptr) {
+        return false;
+    }
+
+    const int32_t step = (int32_t) hparams.n_swa - 1;
+    const int32_t n    = batch.n_tokens;
+
+    // positions must increase within a sequence, and a token must belong to one sequence
+    std::vector<llama_pos> pos_end(LLAMA_MAX_SEQ, -1);
+    for (int32_t i = 0; i < n; ++i) {
+        const llama_seq_id s = batch.n_seq_id[i] == 1 ? batch.seq_id[i][0] : -1;
+        if (s < 0 || s >= LLAMA_MAX_SEQ || batch.pos[i] <= pos_end[s]) {
+            return false;
+        }
+        pos_end[s] = batch.pos[i];
+    }
+
+    // window steps needed to reach a token d positions back
+    const auto steps = [step](int32_t d) { return (d + step - 1)/step; };
+
+    std::vector<llama_pos> next_out(LLAMA_MAX_SEQ, -1); // the next output position at or after the token
+    ced_last_layer.assign(n, (int8_t) (n_layer - 1));
+
+    bool trimmed = false;
+    for (int32_t i = n - 1; i >= 0; --i) {
+        const llama_seq_id s = batch.seq_id[i][0];
+        const llama_pos    p = batch.pos[i];
+        if (batch.logits[i]) {
+            next_out[s] = p;
+        }
+
+        int32_t last = first_dec - 1;
+        if (next_out[s] >= 0) {
+            last = std::max(last, n_layer - 1 - steps(next_out[s] - p));
+        }
+        last = std::max(last, n_layer - 2 - steps(std::max(0, pos_end[s] - p - (margin + step - 1))));
+        last = std::min(last, n_layer - 1);
+
+        ced_last_layer[i] = (int8_t) last;
+        trimmed |= last < n_layer - 1;
+    }
+
+    if (!trimmed) {
+        ced_last_layer.clear();
+    }
+
+    return trimmed;
+}
