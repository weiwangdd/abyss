+void llm_graph_input_ced::set_input(const llama_ubatch * ubatch) {
+    GGML_ASSERT(ubatch->data && ubatch->data->batch_idxs.size() == ubatch->n_tokens);
+
+    const auto & batch_idxs = ubatch->data->batch_idxs;
+
+    for (size_t il = 0; il < idx.size(); ++il) {
+        if (idx[il] == nullptr) {
+            continue;
+        }
+
+        GGML_ASSERT(ggml_backend_buffer_is_host(idx[il]->buffer));
+        int32_t * data = (int32_t *) idx[il]->data;
+
+        int32_t n = 0;
+        for (uint32_t i = 0; i < ubatch->n_tokens; ++i) {
+            if ((*last_layer)[batch_idxs[i]] >= (int32_t) il) {
+                data[n++] = (int32_t) i;
+            }
+        }
+        GGML_ASSERT(n == n_sub[il]);
+    }
+}
+
+bool llm_graph_input_ced::can_reuse(const llm_graph_params & params) {
+    return params.ced_n_sub == n_sub && params.ced_last_layer == last_layer;
+}
