From 1884da5bc9b8eb6ddcb8836f80224d6e3851520b Mon Sep 17 00:00:00 2001
From: abyss <abyss@localhost>
Date: Fri, 6 Nov 2026 10:18:03 +0100
Subject: [PATCH] abyss: ABYSS_MMVQ_TAIL=1 lets mul_mat_vec_q of a single
 column take the several rows per block of small_k also when the K loop of the
 whole block would span a quarter more quant blocks than the loop of one warp
 (72 MXFP4 blocks: 128 against 80), which keeps more bytes in flight per
 thread and the same sums per row; under small_k MXFP4 and Q8_0 take twice the
 rows on the generic table and MXFP4 reads its quants from aligned words
 (get_int2_b1_aligned, vec_dot_mxfp4_q8_1_aligned), the same results;
 ABYSS_Q8_1_CACHE_LEG=1 gives the q8_1 cache a legacy pool of its own
 (ggml_backend_cuda_context::q8_1_pool), since it frees its entries oldest
 first and the VMM pool only takes frees in the reverse order of the
 allocations; test-backend-ops gains the matrix-vector shapes of a DeepSeek
 V4.1 Flash decode step as perf cases

---
 ggml/src/ggml-cuda/common.cuh   | 13 +++++++++++
 ggml/src/ggml-cuda/ggml-cuda.cu | 11 +++++++++-
 ggml/src/ggml-cuda/mmvq.cu      | 32 +++++++++++++++++++++++----
 ggml/src/ggml-cuda/vecdotq.cuh  | 39 +++++++++++++++++++++++++++++++++
 tests/test-backend-ops.cpp      | 11 ++++++++++
 5 files changed, 101 insertions(+), 5 deletions(-)

diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index 09fb179..d270f86 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1667,6 +1667,19 @@ struct ggml_backend_cuda_context {
     ggml_cuda_pool & pool() {
         return pool(device);
     }
+
+    // abyss: a pool of the q8_1 cache's own (ABYSS_Q8_1_CACHE_LEG=1), a legacy one: the cache frees its entries oldest
+    // first, and the VMM pool only takes frees in the reverse order of the allocations (ggml_cuda_pool_vmm::free)
+    std::unique_ptr<ggml_cuda_pool> q8_1_pools[GGML_CUDA_MAX_DEVICES];
+
+    static std::unique_ptr<ggml_cuda_pool> new_leg_pool_for_device(int device);
+
+    ggml_cuda_pool & q8_1_pool() {
+        if (q8_1_pools[device] == nullptr) {
+            q8_1_pools[device] = new_leg_pool_for_device(device);
+        }
+        return *q8_1_pools[device];
+    }
 };
 
 struct ggml_cuda_mm_fusion_args_host {
