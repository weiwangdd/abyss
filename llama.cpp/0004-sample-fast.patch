From d0f45c711917e3ccfa554506ae77f4e9540f3510 Mon Sep 17 00:00:00 2001
From: abyss <abyss@localhost>
Date: Fri, 6 Nov 2026 00:04:18 +0100
Subject: [PATCH] abyss: ABYSS_SAMPLE_FAST=1 samples the token of one output
 straight from its logits when the chain reduces to dist (with
 ABYSS_DIST_VEC=1) or greedy over them, every sampler before it empty (the
 init functions make the samplers whose settings leave the candidates as they
 are empty ones) or, before greedy, a temperature of 0:
 llama_sampler_chain_sample_logits takes the max in sixteen vectorized lanes
 (the value std::max finds one at a time) and the dist sampler's exp and block
 search over the logits, without building the 129,280 candidates or writing
 their probabilities, the same token as the chain; common_sampler_sample_fast
 uses it when no probabilities are wanted and the reasoning budget is not
 forcing a token, keeping the grammar check of the token and the resampling,
 and the server samples a decoded token with it

(cherry picked from commit 6f436704c8da2c6b7110d5bab80ddc741f42ddaf)
---
 common/sampling.cpp             |  50 +++++++++++++
 common/sampling.h               |   6 ++
 include/llama.h                 |   6 ++
 src/llama-sampler.cpp           | 125 ++++++++++++++++++++++++++++++++
 tools/server/server-context.cpp |   2 +-
 5 files changed, 188 insertions(+), 1 deletion(-)

diff --git a/common/sampling.cpp b/common/sampling.cpp
index 564fa9c..40478d8 100644
--- a/common/sampling.cpp
+++ b/common/sampling.cpp
@@ -687,6 +687,56 @@ llama_token common_sampler_sample(struct common_sampler * gsmpl, struct llama_co
     return id;
 }
 
+llama_token common_sampler_sample_fast(struct common_sampler * gsmpl, struct llama_context * ctx, int idx) {
+    // the reasoning budget changes the logits only while it forces its tokens
+    if (gsmpl->params.n_probs == 0 && common_reasoning_budget_get_state(gsmpl->rbudget) != REASONING_BUDGET_FORCING) {
+        llama_synchronize(ctx);
+
+        if (llama_get_sampled_token_ith(ctx, idx) == LLAMA_TOKEN_NULL && llama_get_sampled_probs_ith(ctx, idx) == nullptr &&
+                llama_get_sampled_logits_ith(ctx, idx) == nullptr) {
+            const auto tm = gsmpl->tm();
+
+            const llama_vocab * vocab = llama_model_get_vocab(llama_get_model(ctx));
+            llama_token id = llama_sampler_chain_sample_logits(gsmpl->chain, llama_get_logits_ith(ctx, idx), llama_vocab_n_tokens(vocab));
+            if (id != LLAMA_TOKEN_NULL) {
+                gsmpl->cur_p = { gsmpl->cur.data(), 0, -1, false };
+
+                if (!grammar_should_apply(gsmpl)) {
+                    return id;
+                }
+
+                // the grammar check of the sampled token, as in common_sampler_sample
+                llama_token_data       single_token_data       = { id, 1.0f, 0.0f };
+                llama_token_data_array single_token_data_array = { &single_token_data, 1, -1, false };
+
+                llama_sampler_apply(gsmpl->grmr, &single_token_data_array);
+
+                if (single_token_data_array.data[0].logit != -INFINITY) {
+                    return id;
+                }
+
+                // and its resampling: the grammar constraints first, then the chain
+                auto & cur_p = gsmpl->cur_p;
+                gsmpl->set_logits(ctx, idx);
+
+                llama_sampler_apply(gsmpl->rbudget, &cur_p);
+
+                if (grammar_should_apply(gsmpl)) {
+                    llama_sampler_apply(gsmpl->grmr, &cur_p);
+                }
+
+                llama_sampler_apply(gsmpl->chain, &cur_p);
+
+                GGML_ASSERT(cur_p.selected != -1 && "no selected token during sampling - check your sampling configuration");
+
+                return cur_p.data[cur_p.selected].id;
+            }
+        }
+    }
+
+    return common_sampler_sample(gsmpl, ctx, idx, false);
+}
+
 std::vector<llama_token> common_sampler_sample_and_accept_n(struct common_sampler * gsmpl, struct llama_context * ctx, const std::vector<int> & idxs, const llama_tokens & draft, bool grammar_first) {
     GGML_ASSERT(idxs.size() == draft.size() + 1 && "idxs.size() must be draft.size() + 1");
 
diff --git a/common/sampling.h b/common/sampling.h
index f19bd27..455dde6 100644
--- a/common/sampling.h
+++ b/common/sampling.h
@@ -67,6 +67,12 @@ struct llama_sampler * common_sampler_get(const struct common_sampler * gsmpl);
 //
 llama_token common_sampler_sample(struct common_sampler * gsmpl, struct llama_context * ctx, int idx, bool grammar_first = false);
 
+// abyss: common_sampler_sample(gsmpl, ctx, idx) that, with ABYSS_SAMPLE_FAST=1, samples from the logits directly when no
+// probabilities are wanted, the reasoning budget is not forcing a token and the chain reduces to a dist or greedy
+// sampler (llama_sampler_chain_sample_logits); the grammar check of the token and the resampling stay as they are.
+// The candidates (common_sampler_get_candidates) are then empty
+llama_token common_sampler_sample_fast(struct common_sampler * gsmpl, struct llama_context * ctx, int idx);
+
 // generalized version of common_sampler_sample
 //
 // will cross-reference the sampled tokens with a batch of draft tokens and accept those that match
diff --git a/include/llama.h b/include/llama.h
index 428f51f..83c473a 100644
--- a/include/llama.h
+++ b/include/llama.h
@@ -1467,6 +1467,12 @@ extern "C" {
     // the total number of samplers in the chain
     LLAMA_API int32_t                llama_sampler_chain_n  (const struct llama_sampler * chain);
 
+    // abyss: with ABYSS_SAMPLE_FAST=1, the token the chain samples from the n_vocab logits of one output, taken from
+    // the logits themselves when the chain reduces to a dist (with ABYSS_DIST_VEC=1) or greedy sampler over them, all
+    // the samplers before it leaving the candidates as they are; the same token as applying the chain to those
+    // candidates, without building them or writing their probabilities. LLAMA_TOKEN_NULL when the chain does more
+    LLAMA_API llama_token            llama_sampler_chain_sample_logits(struct llama_sampler * chain, const float * logits, int32_t n_vocab);
+
     // after removing a sampler, the chain will no longer own it, and it will not be freed when the chain is freed
     LLAMA_API struct llama_sampler * llama_sampler_chain_remove(   struct llama_sampler * chain, int32_t i);
 
diff --git a/src/llama-sampler.cpp b/src/llama-sampler.cpp
index b813165..79fb667 100644
--- a/src/llama-sampler.cpp
+++ b/src/llama-sampler.cpp
@@ -4511,3 +4511,128 @@ void llama_perf_sampler_reset(struct llama_sampler * chain) {
     ctx->t_sample_us = 0;
     ctx->n_sample    = 0;
 }
+
+// abyss: ABYSS_SAMPLE_FAST, see llama_sampler_chain_sample_logits
+
+// a temperature of 0 keeps the first of the highest logits, the one greedy picks too
+static bool abyss_sampler_is_zero_temp(const struct llama_sampler * smpl) {
+    if (smpl->iface == &llama_sampler_temp_i) {
+        return ((const llama_sampler_temp *) smpl->ctx)->temp <= 0.0f;
+    }
+    if (smpl->iface == &llama_sampler_temp_ext_i) {
+        const auto * ctx = (const llama_sampler_temp_ext *) smpl->ctx;
+        return ctx->delta <= 0.0f && ctx->temp <= 0.0f;
+    }
+    return false;
+}
+
+// the largest of x[0..n) as std::max takes it, one at a time from x[0] (so a NaN only when x[0] is one), in sixteen
+// lanes so that the loop vectorizes; a 0 may come out with the other sign
+__attribute__((target_clones("avx512f", "avx2", "default")))
+static float abyss_max_logit(const float * x, size_t n) {
+    float m[16];
+    for (int j = 0; j < 16; ++j) {
+        m[j] = x[0];
+    }
+    size_t i = 0;
+    for (; i + 16 <= n; i += 16) {
+        for (int j = 0; j < 16; ++j) {
+            m[j] = m[j] < x[i + j] ? x[i + j] : m[j];
+        }
+    }
+    for (; i < n; ++i) {
+        m[0] = m[0] < x[i] ? x[i] : m[0];
+    }
+    float r = m[0];
+    for (int j = 1; j < 16; ++j) {
+        r = r < m[j] ? m[j] : r;
+    }
+    return r;
+}
+
+llama_token llama_sampler_chain_sample_logits(struct llama_sampler * smpl, const float * logits, int32_t n_vocab) {
+    static const bool fast = [] {
+        const char * e = getenv("ABYSS_SAMPLE_FAST");
+        return e != nullptr && atoi(e) != 0;
+    }();
+    static const bool dist_vec = [] {
+        const char * e = getenv("ABYSS_DIST_VEC");
+        return e != nullptr && atoi(e) != 0;
+    }();
+    if (!fast || smpl == nullptr || smpl->iface != &llama_sampler_chain_i || logits == nullptr || n_vocab < 2) {
+        return LLAMA_TOKEN_NULL;
+    }
+
+    auto * chain = (llama_sampler_chain *) smpl->ctx;
+    if (chain->is_init || chain->samplers.empty()) {
+        return LLAMA_TOKEN_NULL;
+    }
+    const llama_sampler * last = chain->samplers.back().ptr;
+    const bool greedy = last->iface == &llama_sampler_greedy_i;
+    if (!greedy && !(last->iface == &llama_sampler_dist_i && dist_vec)) {
+        return LLAMA_TOKEN_NULL;
+    }
+    // the init functions make the samplers whose settings leave the candidates as they are (a top-k of 0, a top-p of
+    // 1, a temperature of 1, the penalties off, ...) empty ones
+    for (size_t k = 0; k + 1 < chain->samplers.size(); ++k) {
+        const llama_sampler * s = chain->samplers[k].ptr;
+        if (s->iface->apply == nullptr || s->iface == &llama_sampler_empty_i || (greedy && abyss_sampler_is_zero_temp(s))) {
+            continue;
+        }
+        return LLAMA_TOKEN_NULL;
+    }
+
+    time_meas tm(chain->t_sample_us, chain->params.no_perf);
+
+    // the candidates would be the logits in token order, so a candidate's index is its token
+    const float max_l = abyss_max_logit(logits, n_vocab);
+    if (greedy) {
+        // the first of the highest, or the first token when its logit is a NaN, as greedy picks them
+        for (int32_t i = 0; i < n_vocab; ++i) {
+            if (logits[i] == max_l) {
+                return i;
+            }
+        }
+        return 0;
+    }
+
+    // the dist sampler with ABYSS_DIST_VEC, over the logits instead of a copy of them as candidates, and without
+    // writing the probabilities back to the candidates; a max of 0 with the other sign leaves every exp(x - max) as it is
+    auto * ctx = (llama_sampler_dist *) last->ctx;
+    std::uniform_real_distribution<double> dist(0.0f, 1.0f);
+
+    const size_t n  = n_vocab;
+    const size_t nb = (n + abyss_dist_block - 1)/abyss_dist_block;
+    ctx->vec_p.resize(n);
+    ctx->vec_bsum.resize(nb);
+    float  * p    = ctx->vec_p.data();
+    double * bsum = ctx->vec_bsum.data();
+    for (size_t i = 0; i < n; ++i) {
+        p[i] = logits[i] - max_l;
+    }
+    abyss_dist_exp(p, n, bsum);
+
+    double sum_cum = 0.0;
+    for (size_t b = 0; b < nb; ++b) {
+        sum_cum += bsum[b];
+    }
+
+    const double rnd     = dist(ctx->rng);
+    const double sum_tgt = sum_cum*rnd;
+
+    double sum_run = 0.0;
+    size_t b = 0;
+    while (b + 1 < nb && sum_run + bsum[b] < sum_tgt) {
+        sum_run += bsum[b];
+        ++b;
+    }
+    size_t selected = n - 1;
+    for (size_t i = b*abyss_dist_block; i < n; ++i) {
+        sum_run += p[i];
+        if (sum_run >= sum_tgt) {
+            selected = i;
+            break;
+        }
+    }
+    return (llama_token) selected;
+}
