         ggml_build_forward_expand(gf, kv);
         ggml_build_forward_expand(gf, inp_attn->mctx->cpy_k(ctx0, kv, inp_attn->get_k_idxs(), il));
 
-        ggml_tensor * raw_k    = inp_attn->mctx->get_k(ctx0, il);
