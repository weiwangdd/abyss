From 2a36834b9f1392df8ddfbd959d644d904cfd50cd Mon Sep 17 00:00:00 2001
From: abyss <abyss@localhost>
Date: Wed, 11 Nov 2026 23:38:45 +0100
Subject: [PATCH] abyss: a DeepSeek-V4.1 fixture for the CED-aware prefill
 (ABYSS_TEST_DSV41_CED=1)

With the variable set, test-llama-archs -a deepseek41 -o <dir> writes a model with a decoder of six layers behind a
window of 16, a top-k of 8, candidate blocks and 8 experts, small enough to compare the prefill with and without
ABYSS_CED_PREFILL on the CPU or in a GPU's spare memory.
---
 tests/test-llama-archs.cpp | 31 +++++++++++++++++++++----------
 1 file changed, 21 insertions(+), 10 deletions(-)

diff --git a/tests/test-llama-archs.cpp b/tests/test-llama-archs.cpp
index 1f4c8a4..18d07a3 100644
--- a/tests/test-llama-archs.cpp
+++ b/tests/test-llama-archs.cpp
@@ -250,7 +250,10 @@ struct kv_writer {
 static gguf_context_ptr get_gguf_ctx(const llm_arch arch, const bool moe, const uint32_t n_layer_min = 0) {
     gguf_context_ptr ret(gguf_init_empty());
     kv_writer ms(arch, ret.get());
-    const uint32_t n_ctx = 256;
+    // abyss: ABYSS_TEST_DSV41_CED=1 turns the DeepSeek-V4.1 fixture into one for the CED-aware prefill: a decoder of six
+    // layers behind a short window, with a real top-k and candidate blocks. Meant for -o, the checks below expect the default
+    const bool dsv41_ced = arch == LLM_ARCH_DEEPSEEK41 && getenv("ABYSS_TEST_DSV41_CED") != nullptr;
+    const uint32_t n_ctx = dsv41_ced ? 4096 : 256;
 
     uint32_t n_vocab = 128;
     uint32_t n_embd  = 256;
@@ -284,7 +287,7 @@ static gguf_context_ptr get_gguf_ctx(const llm_arch arch, const bool moe, const
         n_embd  = 512;
         n_head  = 8;
         n_ff    = 1024;
-        n_layer = 6;
+        n_layer = dsv41_ced ? 12 : 6;
     } else if (arch == LLM_ARCH_STEP35 || arch == LLM_ARCH_LAGUNA) {
         n_embd = 160; // exercise per-head tensor split granularity with head size 80
     } else if (arch == LLM_ARCH_QWEN3 || arch == LLM_ARCH_MUSE_GLIMMER || arch == LLM_ARCH_AFMOE || arch == LLM_ARCH_RICURSIVE) {
@@ -471,7 +474,7 @@ static gguf_context_ptr get_gguf_ctx(const llm_arch arch, const bool moe, const
     ms.add_kv(LLM_KV_ATTENTION_Q_LORA_RANK,            (arch == LLM_ARCH_DEEPSEEK4 || arch == LLM_ARCH_DEEPSEEK41) ? uint32_t(64) : uint32_t(512));
     ms.add_kv(LLM_KV_ATTENTION_KV_LORA_RANK,           uint32_t(512));
     ms.add_kv(LLM_KV_ATTENTION_RELATIVE_BUCKETS_COUNT, uint32_t(8));
-    ms.add_kv(LLM_KV_ATTENTION_SLIDING_WINDOW,         n_ctx/8);
+    ms.add_kv(LLM_KV_ATTENTION_SLIDING_WINDOW,         dsv41_ced ? uint32_t(16) : n_ctx/8);
 
     if (arch == LLM_ARCH_MAION_CODER) {
         ms.add_kv(LLM_KV_ATTENTION_SLIDING_WINDOW_PATTERN, std::vector<uint32_t>{1, 1, 0, 0});
@@ -564,7 +567,7 @@ static gguf_context_ptr get_gguf_ctx(const llm_arch arch, const bool moe, const
     // note: using a realistic top-k here makes the results unstable and hard to match between CPU and GPU
     //       a large value makes things deterministic since all data is selected by the indexer
     //ms.add_kv(LLM_KV_ATTENTION_INDEXER_TOP_K,        uint32_t(8));
-    ms.add_kv(LLM_KV_ATTENTION_INDEXER_TOP_K,        uint32_t(131072));
+    ms.add_kv(LLM_KV_ATTENTION_INDEXER_TOP_K,        dsv41_ced ? uint32_t(8) : uint32_t(131072));
 
     ms.add_kv(LLM_KV_ATTENTION_INDEXER_BLOCK_SIZE,   uint32_t(4));
     ms.add_kv(LLM_KV_ATTENTION_INDEXER_KPOOL,        uint32_t(4));
@@ -619,12 +622,20 @@ static gguf_context_ptr get_gguf_ctx(const llm_arch arch, const bool moe, const
     if (arch == LLM_ARCH_DEEPSEEK41) {
         ms.add_kv(LLM_KV_ATTENTION_OUTPUT_GROUP_COUNT,          uint32_t(8));
         ms.add_kv(LLM_KV_ATTENTION_OUTPUT_LORA_RANK,            uint32_t(32));
-        ms.add_kv(LLM_KV_ATTENTION_COMPRESS_RATIOS,             std::vector<uint32_t>({0, 0, 2, 2, 1, 1}));
+        if (dsv41_ced) {
+            ms.add_kv(LLM_KV_ATTENTION_COMPRESS_RATIOS,             std::vector<uint32_t>({0, 0, 2, 2, 2, 2, 1, 1, 1, 1, 1, 1}));
+            ms.add_kv(LLM_KV_ATTENTION_KV_SOURCE_LAYERS,            std::vector<uint32_t>({2, 4, 6}));
+            ms.add_kv(LLM_KV_ATTENTION_INDEXER_SOURCE_LAYERS,       std::vector<uint32_t>({2, 4, 6, 8, 10}));
+            ms.add_kv(LLM_KV_ATTENTION_INDEXER_CANDIDATE_SOURCE_LAYER, int32_t(6));
+            ms.add_kv(LLM_KV_ATTENTION_INDEXER_CANDIDATE_TOP_K_BLOCKS, uint32_t(8));
+        } else {
+            ms.add_kv(LLM_KV_ATTENTION_COMPRESS_RATIOS,             std::vector<uint32_t>({0, 0, 2, 2, 1, 1}));
+            ms.add_kv(LLM_KV_ATTENTION_KV_SOURCE_LAYERS,            std::vector<uint32_t>({2, 4}));
+            ms.add_kv(LLM_KV_ATTENTION_INDEXER_SOURCE_LAYERS,       std::vector<uint32_t>({2, 4, 5}));
+            ms.add_kv(LLM_KV_ATTENTION_INDEXER_CANDIDATE_SOURCE_LAYER, int32_t(4));
+            ms.add_kv(LLM_KV_ATTENTION_INDEXER_CANDIDATE_TOP_K_BLOCKS, uint32_t(4096));
+        }
         ms.add_kv(LLM_KV_ATTENTION_COMPRESS_ROPE_FREQ_BASE,     160000.0f);
-        ms.add_kv(LLM_KV_ATTENTION_KV_SOURCE_LAYERS,            std::vector<uint32_t>({2, 4}));
-        ms.add_kv(LLM_KV_ATTENTION_INDEXER_SOURCE_LAYERS,       std::vector<uint32_t>({2, 4, 5}));
-        ms.add_kv(LLM_KV_ATTENTION_INDEXER_CANDIDATE_SOURCE_LAYER, int32_t(4));
-        ms.add_kv(LLM_KV_ATTENTION_INDEXER_CANDIDATE_TOP_K_BLOCKS, uint32_t(4096));
         ms.add_kv(LLM_KV_ATTENTION_INDEXER_CANDIDATE_BLOCK_SIZE,   uint32_t(4));
         ms.add_kv(LLM_KV_HYPER_CONNECTION_COUNT,                uint32_t(4));
         ms.add_kv(LLM_KV_HYPER_CONNECTION_SINKHORN_ITERATIONS,  uint32_t(2));
@@ -713,7 +724,7 @@ static gguf_context_ptr get_gguf_ctx(const llm_arch arch, const bool moe, const
         ms.add_kv(LLM_KV_EXPERT_LATENT_LENGTH,       n_ff);
         ms.add_kv(LLM_KV_INTERLEAVE_MOE_LAYER_STEP,  uint32_t(2));
         // with more experts than a ubatch uses, the copy of the used experts in host memory skips some of them
-        ms.add_kv(LLM_KV_EXPERT_COUNT,               uint32_t(host_experts_test(arch) ? 64 : arch == LLM_ARCH_CLOVER_MOE ? 4 : 2));
+        ms.add_kv(LLM_KV_EXPERT_COUNT,               uint32_t(host_experts_test(arch) ? 64 : dsv41_ced ? 8 : arch == LLM_ARCH_CLOVER_MOE ? 4 : 2));
         ms.add_kv(LLM_KV_EXPERT_USED_COUNT,          uint32_t(2));
         ms.add_kv(LLM_KV_EXPERT_SHARED_COUNT,        uint32_t(1));
 
-- 
2.43.0

