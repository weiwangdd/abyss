From b3298ebf2dae54b83f9e92c7aab234e41a7611d2 Mon Sep 17 00:00:00 2001
From: abyss <abyss@localhost>
Date: Wed, 28 Oct 2026 11:53:34 +0100
Subject: [PATCH] abyss: llama-bench takes the expert cache size from
 LLAMA_ARG_MOE_CACHE_MIB, the variable the server's --moe-cache-mib reads

(cherry picked from commit 7985c81a599dfa4e9c211c360d2aa2fbf5efae88)
---
 tools/llama-bench/llama-bench.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/tools/llama-bench/llama-bench.cpp b/tools/llama-bench/llama-bench.cpp
index 5cbdda1..19de23d 100644
--- a/tools/llama-bench/llama-bench.cpp
+++ b/tools/llama-bench/llama-bench.cpp
@@ -1319,6 +1319,12 @@ struct cmd_params_instance {
         cparams.op_offload      = !no_op_offload;
         cparams.swa_full        = false;
 
+        // abyss: the device cache for the experts kept in host memory (the server's --moe-cache-mib), from the
+        // environment variable the server reads too
+        if (const char * e = getenv("LLAMA_ARG_MOE_CACHE_MIB")) {
+            cparams.moe_cache_size = (size_t) atoll(e)*1024*1024;
+        }
+
         return cparams;
     }
 };
