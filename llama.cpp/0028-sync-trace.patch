From 5de5ae95e458964b0cc8be86bb5f16577235afb4 Mon Sep 17 00:00:00 2001
From: abyss <abyss@localhost>
Date: Thu, 12 Nov 2026 16:14:37 +0100
Subject: [PATCH] abyss: ABYSS_SYNC_TRACE=<ms> prints each wait of the
 scheduler for a backend that takes at least that long

---
 ggml/src/ggml-backend.cpp | 33 +++++++++++++++++++++++++++------
 1 file changed, 27 insertions(+), 6 deletions(-)

diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index 8186159..bd7de6d 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -2042,10 +2042,31 @@ static bool ggml_backend_sched_overlap(void) {
     return overlap;
 }
 
+// abyss: ABYSS_SYNC_TRACE=<ms> prints each wait of the scheduler for a backend that takes at least that long, with the
+// place and, for the copy of an input, its name
+static void ggml_backend_sched_wait(ggml_backend_t backend, const char * where, const struct ggml_tensor * input) {
+    static int trace_ms = -1;
+    if (trace_ms < 0) {
+        const char * e = getenv("ABYSS_SYNC_TRACE");
+        trace_ms = e != NULL ? atoi(e) : 0;
+    }
+    if (trace_ms <= 0) {
+        ggml_backend_synchronize(backend);
+        return;
+    }
+    const int64_t t0 = ggml_time_us();
+    ggml_backend_synchronize(backend);
+    const int64_t dt = ggml_time_us() - t0;
+    if (dt >= (int64_t) trace_ms*1000) {
+        fprintf(stderr, "abyss: sync %s: %s waited %.1f ms%s%s\n", where, ggml_backend_name(backend), dt/1000.0,
+                input != NULL ? " for " : "", input != NULL ? input->name : "");
+    }
+}
+
 static void ggml_backend_sched_synchronize_backends(void * user_data) {
     ggml_backend_sched_t sched = (ggml_backend_sched_t) user_data;
     for (int i = 0; i < sched->n_backends; i++) {
-        ggml_backend_synchronize(sched->backends[i]);
+        ggml_backend_sched_wait(sched->backends[i], "realloc", NULL);
     }
 }
 
@@ -2146,7 +2167,7 @@ static void ggml_backend_sched_copy_input(ggml_backend_sched_t sched, struct ggm
         if (sched->events[split_backend_id][sched->cur_copy] != NULL) {
             ggml_backend_event_synchronize(sched->events[split_backend_id][sched->cur_copy]);
         } else {
-            ggml_backend_synchronize(split_backend);
+            ggml_backend_sched_wait(split_backend, "user input", input);
         }
         ggml_backend_tensor_copy(input, input_cpy);
         return;
@@ -2170,7 +2191,7 @@ static void ggml_backend_sched_copy_input(ggml_backend_sched_t sched, struct ggm
     if (sched->events[split_backend_id][sched->cur_copy] != NULL) {
         ggml_backend_event_wait(split_backend, sched->events[split_backend_id][sched->cur_copy]);
     } else {
-        ggml_backend_synchronize(split_backend);
+        ggml_backend_sched_wait(split_backend, "input", input);
     }
 
     if (weight_cb && !weight_nowait &&
@@ -2181,11 +2202,11 @@ static void ggml_backend_sched_copy_input(ggml_backend_sched_t sched, struct ggm
     // try async copy, but if not possible, we can still use a sync copy without synchronizing the dst backend, since we handle the synchronization here with multiple copies and events
     // TODO: add public function to facilitate this, since applications do not have direct access to the backend interface
     if (!split_backend->iface.cpy_tensor_async || !split_backend->iface.cpy_tensor_async(input_backend, split_backend, input, input_cpy)) {
-        ggml_backend_synchronize(input_backend);
+        ggml_backend_sched_wait(input_backend, "input source", input);
         if (sched->events[split_backend_id][sched->cur_copy] != NULL) {
             ggml_backend_event_synchronize(sched->events[split_backend_id][sched->cur_copy]);
         } else {
-            ggml_backend_synchronize(split_backend);
+            ggml_backend_sched_wait(split_backend, "sync copy", input);
         }
         ggml_backend_tensor_copy(input, input_cpy);
     }
@@ -2264,7 +2285,7 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
             if (sched->events[prev_backend_id][sched->cur_copy] != NULL) {
                 ggml_backend_event_synchronize(sched->events[prev_backend_id][sched->cur_copy]);
             } else {
-                ggml_backend_synchronize(sched->backends[prev_backend_id]);
+                ggml_backend_sched_wait(sched->backends[prev_backend_id], "split without inputs", NULL);
             }
         }
 
