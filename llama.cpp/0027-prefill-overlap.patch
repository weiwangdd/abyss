From 214c2127971630287d4a24d782669da8573bde07 Mon Sep 17 00:00:00 2001
From: abyss <abyss@localhost>
Date: Thu, 12 Nov 2026 16:14:34 +0100
Subject: [PATCH] abyss: the devices keep computing across the ubatches of a
 long prompt (ABYSS_OVERLAP=1)

Two places made the host wait for every device between two ubatches, so that the GPUs took turns: a graph with other
tensor sizes, as the masks grow with the KV cache, stopped all the devices before its buffers got their new layout,
and the output rows of a ubatch without outputs, an input of zero bytes, were waited for like any other input. With
the variable set the devices are stopped only when a buffer has to grow (ggml_gallocr_reserve_n_lazy), and an input
of zero bytes is skipped. Work that is queued keeps the addresses it was launched with, and what the next graph
writes into a device's buffer comes after it: its kernels on the device's queue, its inputs after the wait for that
device.
---
 ggml/include/ggml-alloc.h |  9 +++++++++
 ggml/src/ggml-alloc.c     | 18 +++++++++++++++---
 ggml/src/ggml-backend.cpp | 39 +++++++++++++++++++++++++++++++++++----
 3 files changed, 59 insertions(+), 7 deletions(-)

diff --git a/ggml/include/ggml-alloc.h b/ggml/include/ggml-alloc.h
index 81cce2e..01ade26 100644
--- a/ggml/include/ggml-alloc.h
+++ b/ggml/include/ggml-alloc.h
@@ -55,6 +55,15 @@ GGML_API void           ggml_gallocr_free(ggml_gallocr_t galloc);
 // returns false if the buffer allocation failed
 // ggml_gallocr_resrve_n_size writes the buffer sizes per galloc buffer that would be allocated by ggml_gallocr_reserve_n to sizes
 GGML_API bool ggml_gallocr_reserve(ggml_gallocr_t galloc, struct ggml_cgraph * graph);
+// abyss: as ggml_gallocr_reserve_n, and calls before_realloc once, before the first buffer is freed to be allocated again;
+// when the buffers are large enough for the graph they stay where they are and it is not called
+GGML_API bool ggml_gallocr_reserve_n_lazy(
+    ggml_gallocr_t galloc,
+    struct ggml_cgraph * graph,
+    const int * node_buffer_ids,
+    const int * leaf_buffer_ids,
+    void (*before_realloc)(void * user_data),
+    void * user_data);
 GGML_API void ggml_gallocr_reserve_n_size(
     ggml_gallocr_t galloc,
     struct ggml_cgraph * graph,
diff --git a/ggml/src/ggml-alloc.c b/ggml/src/ggml-alloc.c
index 9f16877..88d5d8c 100644
--- a/ggml/src/ggml-alloc.c
+++ b/ggml/src/ggml-alloc.c
@@ -839,8 +839,10 @@ static void ggml_gallocr_alloc_graph_impl(ggml_gallocr_t galloc, struct ggml_cgr
     }
 }
 
+// abyss: before_realloc, if set, is called once, before the first buffer is freed to be allocated again
 static bool ggml_gallocr_reserve_n_impl(
-        ggml_gallocr_t galloc, struct ggml_cgraph * graph, const int * node_buffer_ids, const int * leaf_buffer_ids, bool no_alloc) {
+        ggml_gallocr_t galloc, struct ggml_cgraph * graph, const int * node_buffer_ids, const int * leaf_buffer_ids, bool no_alloc,
+        void (*before_realloc)(void * user_data), void * user_data) {
     size_t min_hash_size = graph->n_nodes + graph->n_leafs;
     // add 25% margin to avoid hash collisions
     min_hash_size += min_hash_size / 4;
@@ -956,6 +958,10 @@ static bool ggml_gallocr_reserve_n_impl(
             }
         }
         if (realloc) {
+            if (before_realloc != NULL) {
+                before_realloc(user_data);
+                before_realloc = NULL;
+            }
 #ifndef NDEBUG
             {
                 size_t cur_size = galloc->buffers[i] ? ggml_vbuffer_size(galloc->buffers[i]) : 0;
@@ -983,7 +989,7 @@ static bool ggml_gallocr_reserve_n_impl(
 
 void ggml_gallocr_reserve_n_size(
         ggml_gallocr_t galloc, struct ggml_cgraph * graph, const int * node_buffer_ids, const int * leaf_buffer_ids, size_t * sizes) {
-    GGML_ASSERT(ggml_gallocr_reserve_n_impl(galloc, graph, node_buffer_ids, leaf_buffer_ids, /*no_alloc =*/ true));
+    GGML_ASSERT(ggml_gallocr_reserve_n_impl(galloc, graph, node_buffer_ids, leaf_buffer_ids, /*no_alloc =*/ true, NULL, NULL));
     for (int i = 0; i < galloc->n_buffers; i++) {
         sizes[i] = 0;
         for (int c = 0; c < galloc->buf_tallocs[i]->n_chunks; c++) {
@@ -993,7 +999,13 @@ void ggml_gallocr_reserve_n_size(
 }
 
 bool ggml_gallocr_reserve_n(ggml_gallocr_t galloc, struct ggml_cgraph * graph, const int * node_buffer_ids, const int * leaf_buffer_ids) {
-    return ggml_gallocr_reserve_n_impl(galloc, graph, node_buffer_ids, leaf_buffer_ids, /*no_alloc =*/ false);
+    return ggml_gallocr_reserve_n_impl(galloc, graph, node_buffer_ids, leaf_buffer_ids, /*no_alloc =*/ false, NULL, NULL);
+}
+
+bool ggml_gallocr_reserve_n_lazy(
+        ggml_gallocr_t galloc, struct ggml_cgraph * graph, const int * node_buffer_ids, const int * leaf_buffer_ids,
+        void (*before_realloc)(void * user_data), void * user_data) {
+    return ggml_gallocr_reserve_n_impl(galloc, graph, node_buffer_ids, leaf_buffer_ids, /*no_alloc =*/ false, before_realloc, user_data);
 }
 
 bool ggml_gallocr_reserve(ggml_gallocr_t galloc, struct ggml_cgraph *graph) {
diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index fd502c0..8186159 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -2026,6 +2026,29 @@ void ggml_backend_sched_split_graph(ggml_backend_sched_t sched, struct ggml_cgra
     }
 }
 
+// abyss: ABYSS_OVERLAP=1 removes two places where the host waits for every device between the ubatches of a long prompt,
+// so that a GPU can start on the next ubatch while another one still computes the previous one:
+// - a graph with other tensor sizes gets a new layout in the compute buffers; the devices are stopped for it only when
+//   a buffer has to grow. Work that is queued already keeps the addresses it was launched with, and everything the next
+//   graph writes into a device's buffer comes after it: its kernels on the device's own queue, and its inputs after the
+//   wait for that device in ggml_backend_sched_copy_input
+// - an input of zero bytes, like the output rows of a ubatch without outputs, is not copied, and not waited for
+static bool ggml_backend_sched_overlap(void) {
+    static int overlap = -1;
+    if (overlap < 0) {
+        const char * e = getenv("ABYSS_OVERLAP");
+        overlap = e != NULL && atoi(e) != 0;
+    }
+    return overlap;
+}
+
+static void ggml_backend_sched_synchronize_backends(void * user_data) {
+    ggml_backend_sched_t sched = (ggml_backend_sched_t) user_data;
+    for (int i = 0; i < sched->n_backends; i++) {
+        ggml_backend_synchronize(sched->backends[i]);
+    }
+}
+
 static bool ggml_backend_sched_alloc_splits(ggml_backend_sched_t sched) {
     bool backend_ids_changed = false;
     for (int i = 0; i < sched->graph.n_nodes; i++) {
@@ -2071,11 +2094,15 @@ static bool ggml_backend_sched_alloc_splits(ggml_backend_sched_t sched) {
 
         // the re-allocation may cause the split inputs to be moved to a different address
         // synchronize without ggml_backend_sched_synchronize to avoid changing cur_copy
-        for (int i = 0; i < sched->n_backends; i++) {
-            ggml_backend_synchronize(sched->backends[i]);
+        bool reserved;
+        if (ggml_backend_sched_overlap() && !backend_ids_changed) {
+            reserved = ggml_gallocr_reserve_n_lazy(sched->galloc, &sched->graph, sched->node_backend_ids, sched->leaf_backend_ids,
+                    ggml_backend_sched_synchronize_backends, sched);
+        } else {
+            ggml_backend_sched_synchronize_backends(sched);
+            reserved = ggml_gallocr_reserve_n(sched->galloc, &sched->graph, sched->node_backend_ids, sched->leaf_backend_ids);
         }
-
-        if (!ggml_gallocr_reserve_n(sched->galloc, &sched->graph, sched->node_backend_ids, sched->leaf_backend_ids)) {
+        if (!reserved) {
             GGML_LOG_ERROR("%s: failed to reserve graph buffers\n", __func__);
             return false;
         }
@@ -2100,6 +2127,10 @@ static void ggml_backend_sched_copy_input(ggml_backend_sched_t sched, struct ggm
     ggml_backend_t input_backend = ggml_backend_sched_get_tensor_backend(sched, input);
     struct ggml_tensor * input_cpy = tensor_copy(input, split_backend_id, sched->cur_copy);
 
+    if (ggml_backend_sched_overlap() && ggml_nbytes(input) == 0) {
+        return;
+    }
+
     // read before the previous split, wait for the copy only
     if (split == &sched->splits[sched->prefetch_split]) {
         for (int i = 0; i < sched->n_prefetched; i++) {
-- 
