From faae931f70bcf95e0c3a7d95331898ed13b76312 Mon Sep 17 00:00:00 2001
From: abyss <abyss@localhost>
Date: Mon, 26 Oct 2026 19:35:51 +0100
Subject: [PATCH] abyss: ABYSS_DECODE_STATS=N logs, every N single-token
 decodes, the time per token, the expert cache counts and the major page
 faults per token

(cherry picked from commit 9bbe42926dd70d4e774d03e94b25bcc54f52c72c)
---
 src/llama-context.cpp   | 52 +++++++++++++++++++++++++++++++++++++++++
 src/llama-context.h     | 13 +++++++++++
 src/llama-moe-cache.cpp |  6 +++++
 src/llama-moe-cache.h   |  4 ++++
 4 files changed, 75 insertions(+)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index c430231..6e53404 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -23,6 +23,8 @@
 #include <string>
 #include <unordered_map>
 
+#include <sys/resource.h>
+
 //
 // llama_context
 //
@@ -2159,6 +2161,39 @@ static bool needs_raw_logits(const llama_ubatch & ubatch, const std::map<llama_s
     return false; // all sequences use backend sampling
 }
 
+llama_context::decode_stats_counts llama_context::decode_stats_now() const {
+    decode_stats_counts c;
+    c.t_us = ggml_time_us();
+    if (moe_cache) {
+        moe_cache->small_counts(c.hits, c.up, c.cpu);
+    }
+    rusage ru = {};
+    getrusage(RUSAGE_SELF, &ru);
+    c.majflt = ru.ru_majflt;
+    return c;
+}
+
+void llama_context::decode_stats_add(const decode_stats_counts & start, int32_t every) {
+    const decode_stats_counts end = decode_stats_now();
+    auto & w = decode_stats;
+    w.t_us   += end.t_us   - start.t_us;
+    w.hits   += end.hits   - start.hits;
+    w.up     += end.up     - start.up;
+    w.cpu    += end.cpu    - start.cpu;
+    w.majflt += end.majflt - start.majflt;
+    if (++decode_stats_n < every) {
+        return;
+    }
+    const double n    = decode_stats_n;
+    const double used = (double) (w.hits + w.up + w.cpu);
+    // the server does not show info logs of the library
+    fprintf(stderr, "abyss: decode stats, %d tokens: %.1f ms/token, expert cache hit rate %.1f%%, per token %.1f hits, "
+        "%.1f uploaded, %.1f by the CPU, %.1f major page faults\n", decode_stats_n, w.t_us/1000.0/n,
+        used > 0 ? 100.0*w.hits/used : 0.0, w.hits/n, w.up/n, w.cpu/n, w.majflt/n);
+    w = {};
+    decode_stats_n = 0;
+}
+
 int llama_context::decode(const llama_batch_ext & batch_inp) {
     if (!memory) {
         LLAMA_LOG_DEBUG("%s: cannot decode batches with this context (calling encode() instead)\n", __func__);
@@ -2170,6 +2205,23 @@ int llama_context::decode(const llama_batch_ext & batch_inp) {
         return -1;
     }
 
+    // abyss: ABYSS_DECODE_STATS=N prints, every N single-token decodes, their time per token, what the expert cache did
+    // per token and the process's major page faults per token: Engram rows read from disk, the tables being mmapped
+    static const int32_t decode_stats_every = [] {
+        const char * e = getenv("ABYSS_DECODE_STATS");
+        return e != nullptr ? std::max(0, atoi(e)) : 0;
+    }();
+    struct decode_stats_scope {
+        llama_context * ctx;
+        decode_stats_counts start;
+        ~decode_stats_scope() {
+            if (ctx) {
+                ctx->decode_stats_add(start, decode_stats_every);
+            }
+        }
+    } decode_stats_guard { decode_stats_every > 0 && batch_inp.tokens.size() == 1 ? this : nullptr,
+                           decode_stats_every > 0 && batch_inp.tokens.size() == 1 ? decode_stats_now() : decode_stats_counts{} };
+
     if (batch_inp.n_embd > 0 && batch_inp.n_embd != batch_inp.n_embd_inp) {
         LLAMA_LOG_ERROR("%s: embd row width %zu does not match the decoder input %zu\n",
                 __func__, batch_inp.n_embd, batch_inp.n_embd_inp);
diff --git a/src/llama-context.h b/src/llama-context.h
index 8ff9de2..fad54ba 100644
--- a/src/llama-context.h
+++ b/src/llama-context.h
@@ -350,6 +350,19 @@ private:
     llama_memory_ptr memory;
     llama_moe_cache_ptr moe_cache;
 
+    // abyss: ABYSS_DECODE_STATS, sums over the window of single-token decodes being counted, see decode()
+    struct decode_stats_counts {
+        int64_t t_us   = 0;
+        size_t  hits   = 0; // experts read from the cache, uploaded into it, computed by the CPU
+        size_t  up     = 0;
+        size_t  cpu    = 0;
+        long    majflt = 0; // major page faults of the process
+    };
+    decode_stats_counts decode_stats_now() const;
+    void decode_stats_add(const decode_stats_counts & start, int32_t every);
+    decode_stats_counts decode_stats;
+    int32_t decode_stats_n = 0;
+
     // decode output (2-dimensional array: [n_outputs][n_vocab])
     buffer_view<float> logits = {nullptr, 0};
 
diff --git a/src/llama-moe-cache.cpp b/src/llama-moe-cache.cpp
index 965f6a1..e702cd2 100644
--- a/src/llama-moe-cache.cpp
+++ b/src/llama-moe-cache.cpp
@@ -894,6 +894,12 @@ ggml_tensor * llama_moe_cache::get_cpu_map(int32_t il, int64_t n_tokens) const {
     return pimpl->get_cpu_map(il, n_tokens);
 }
 
+void llama_moe_cache::small_counts(size_t & hits, size_t & uploaded, size_t & cpu) const {
+    hits     = pimpl->stats_small.hits;
+    uploaded = pimpl->stats_small.misses - pimpl->stats_small.cpu;
+    cpu      = pimpl->stats_small.cpu;
+}
+
 bool llama_moe_cache::copy(ggml_backend_t backend, const ggml_tensor * src, ggml_tensor * dst, ggml_cgraph * graph) {
     return pimpl->copy(backend, src, dst, graph);
 }
diff --git a/src/llama-moe-cache.h b/src/llama-moe-cache.h
index 636bc45..10944fd 100644
--- a/src/llama-moe-cache.h
+++ b/src/llama-moe-cache.h
@@ -31,6 +31,10 @@ public:
     // nullptr if no misses of layer il are computed on the CPU for ubatches of n_tokens tokens
     ggml_tensor * get_cpu_map(int32_t il, int64_t n_tokens) const;
 
+    // abyss: what the ubatches of up to 8 tokens did so far: selected experts found in the cache, uploaded to it and
+    // computed by the CPU
+    void small_counts(size_t & hits, size_t & uploaded, size_t & cpu) const;
+
     // ggml_backend_sched copy callback, returns false if src is not a slot map
     bool copy(ggml_backend_t backend, const ggml_tensor * src, ggml_tensor * dst, ggml_cgraph * graph);
 
-- 
