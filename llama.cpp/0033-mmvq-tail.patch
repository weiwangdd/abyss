From 477c967292e9f515e8fbea53edd265081338a5cc Mon Sep 17 00:00:00 2001
From: abyss <abyss@localhost>
Date: Thu, 12 Nov 2026 18:46:21 +0100
Subject: [PATCH] abyss: ABYSS_MMVQ_TAIL=1 lets mul_mat_vec_q of a single
 column take the several rows per block of small_k also when the K loop of the
 whole block would span a quarter more quant blocks than the loop of one warp;
 under small_k MXFP4 and Q8_0 take twice the rows on the generic table and
 MXFP4 reads its quants from aligned words; test-backend-ops gains the
 matrix-vector shapes of a DeepSeek V4.1 Flash decode step as perf cases

---
 ggml/src/ggml-cuda/mmvq.cu     | 25 +++++++++++++++++++++-
 ggml/src/ggml-cuda/vecdotq.cuh | 39 ++++++++++++++++++++++++++++++++++
 tests/test-backend-ops.cpp     | 11 ++++++++++
 3 files changed, 74 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index b57b26b..3965d47 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -598,6 +598,11 @@ static constexpr __host__ __device__ int calc_rows_per_block(ggml_type type, int
         switch (ncols_dst) {
             case 1:
                 if (small_k) {
+                    // abyss: twice the rows for MXFP4 and Q8_0 on the generic table, more bytes in flight per thread;
+                    // each row keeps the threads and the order of its sums
+                    if (table_id == MMVQ_PARAMETERS_GENERIC && (type == GGML_TYPE_MXFP4 || type == GGML_TYPE_Q8_0)) {
+                        return 2*nwarps;
+                    }
                     return nwarps;
                 }
                 if (table_id == MMVQ_PARAMETERS_GB10) {
@@ -641,7 +646,9 @@ static __global__ void mul_mat_vec_q(
     constexpr int rows_per_cuda_block = calc_rows_per_block(type, ncols_dst, table_id, small_k, nwarps);
     constexpr int warp_size = ggml_cuda_get_physical_warp_size();
 
-    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+    // abyss: the aligned loads of MXFP4 when each thread works on several rows
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda =
+        small_k && type == GGML_TYPE_MXFP4 ? vec_dot_mxfp4_q8_1_aligned : get_vec_dot_q_cuda(type);
 
     const     int tid = warp_size*threadIdx.y + threadIdx.x;
     const     int row0 = rows_per_cuda_block*blockIdx.x;
@@ -1146,6 +1153,22 @@ static void mul_mat_vec_q_switch_ncols_dst(
         const int  nwarps = calc_nwarps(type, c_ncols_dst, table_id);
         bool       use    = nwarps > 1 && blocks_per_row_x < nwarps * blocks_per_iter_1warp;
 
+        // abyss: ABYSS_MMVQ_TAIL=1 also takes the several rows per block of small_k when the K loop of the whole block
+        // would span a quarter more quant blocks than the loop of a single warp, i.e. leave many of its threads idle in
+        // its last iteration (72 MXFP4 blocks span 128 for the block, 80 for a warp): more bytes in flight per thread,
+        // the same sums per row. With less to gain (160 MXFP4 blocks: 192 against 160) the grid of fewer, longer
+        // blocks lost more than it won when only six experts were read
+        static const bool tail = [] {
+            const char * e = getenv("ABYSS_MMVQ_TAIL");
+            return e != nullptr && atoi(e) != 0;
+        }();
+        if (tail && !use && nwarps > 1) {
+            const int per_block  = nwarps * blocks_per_iter_1warp;
+            const int span_block = (blocks_per_row_x + per_block - 1) / per_block * per_block;
+            const int span_warp  = (blocks_per_row_x + blocks_per_iter_1warp - 1) / blocks_per_iter_1warp * blocks_per_iter_1warp;
+            use = 4*span_block >= 5*span_warp;
+        }
+
         constexpr std::array<ggml_type, 2> iq_slow_turing = {
             GGML_TYPE_IQ3_XXS,
             GGML_TYPE_IQ3_S,
diff --git a/ggml/src/ggml-cuda/vecdotq.cuh b/ggml/src/ggml-cuda/vecdotq.cuh
index d5ff93b..acc0c6f 100644
--- a/ggml/src/ggml-cuda/vecdotq.cuh
+++ b/ggml/src/ggml-cuda/vecdotq.cuh
@@ -328,6 +328,45 @@ static __device__ __forceinline__ float vec_dot_mxfp4_q8_1(
     return d * sumi;
 }
 
+// abyss: the two ints from i32 on of x at any alignment, from the two or three aligned words that hold them; the
+// 17-byte blocks of MXFP4 put qs at any alignment, and get_int_b1 loads every byte on its own. A third word is read
+// only when it holds bytes of the second int, so no load goes past the bytes asked for by more than the rest of their
+// aligned word
+static __device__ __forceinline__ int2 get_int2_b1_aligned(const void * x, const int & i32) {
+    const uintptr_t  a  = (uintptr_t) x + 4*i32;
+    const uint32_t * w  = (const uint32_t *) (a & ~(uintptr_t) 3);
+    const uint32_t   sh = (uint32_t) (a & 3) * 8;
+    const uint32_t   w0 = w[0];
+    const uint32_t   w1 = w[1];
+    const uint32_t   w2 = sh ? w[2] : 0;
+    return make_int2((int) __funnelshift_r(w0, w1, sh), (int) __funnelshift_r(w1, w2, sh));
+}
+
+// abyss: vec_dot_mxfp4_q8_1 with the quants of the two ints from aligned words (get_int2_b1_aligned), the same
+// result; faster when each thread works on several rows (small_k), slower for one
+static __device__ __forceinline__ float vec_dot_mxfp4_q8_1_aligned(
+    const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
+
+    const block_mxfp4 * bq4 = (const block_mxfp4 *) vbq + kbx;
+
+    const int * q8 = (const int *) bq8_1->qs + iqs;
+
+    static_assert(VDR_MXFP4_Q8_1_MMVQ == 2, "the loads below read two ints");
+    const int2 aux = get_int2_b1_aligned(bq4->qs, iqs);
+
+    int sumi = 0;
+#pragma unroll
+    for (int l = 0; l < VDR_MXFP4_Q8_1_MMVQ; ++l) {
+        const int2 v = get_int_from_table_16(l == 0 ? aux.x : aux.y, kvalues_mxfp4);
+
+        sumi = ggml_cuda_dp4a(v.x, q8[l + 0], sumi);
+        sumi = ggml_cuda_dp4a(v.y, q8[l + 4], sumi);
+    }
+
+    const float d = ggml_cuda_e8m0_to_fp32(bq4->e) * 0.5f * __low2float(bq8_1->ds);
+    return d * sumi;
+}
+
 #define VDR_NVFP4_Q8_1_MMVQ 4
 #define VDR_NVFP4_Q8_1_MMQ  8
 
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index 7e4f80f..fca1205 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -13446,6 +13446,17 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
 static std::vector<std::unique_ptr<test_case>> make_test_cases_perf() {
     std::vector<std::unique_ptr<test_case>> test_cases;
 
+    // abyss: the matrix-vector products of a DeepSeek V4.1 Flash decode step, the routed experts MXFP4 (gate and up
+    // 2304 x 5120, down 5120 x 2304), the attention and the shared experts Q8_0; 32 experts used of 32 and 8 batches
+    // of the dense ones, so that a run reads more than the L2 cache holds
+    for (auto [m, k] : {std::pair<int64_t, int64_t>{2304, 5120}, {5120, 2304}}) {
+        test_cases.emplace_back(new test_mul_mat_id(GGML_TYPE_MXFP4, GGML_TYPE_F32, 32, 32, false, m, 1, k));
+    }
+    for (auto [m, k] : {std::pair<int64_t, int64_t>{32768, 1280}, {8192, 4096}, {5120, 8192}, {1280, 5120}, {512, 5120},
+                        {2304, 5120}, {5120, 2304}}) {
+        test_cases.emplace_back(new test_mul_mat(GGML_TYPE_Q8_0, GGML_TYPE_F32, m, 1, k, {8, 1}, {1, 1}));
+    }
+
     for (float n : {128.0f, 4096.0f, 32768.0f, 1048576.0f}) {
         test_cases.emplace_back(new test_arange(GGML_TYPE_F32, 0.0f, n, 1.0f));
     }
